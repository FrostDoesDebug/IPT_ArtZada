@{
    ViewBag.Title = "User Overview";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-users-wrap admin-user-overview-page">
    @Html.AntiForgeryToken()
    <div class="admin-users-panel">
        <div id="activeUsersList"></div>
    </div>
</div>

<div id="viewUserModal" class="admin-ban-modal" aria-hidden="true">
    <div class="admin-ban-modal-card" role="dialog" aria-modal="true" aria-labelledby="viewModalTitle">
        <h3 id="viewModalTitle">User Details</h3>
        <div style="display:flex;justify-content:center;margin:10px 0 12px;">
            <img id="viewUserAvatar" src="" alt="User avatar" style="width:72px;height:72px;border-radius:50%;border:2px solid #111;object-fit:cover;background:#fff;" />
        </div>
        <div id="viewUserName" style="font-weight:800;font-size:20px;color:#111;margin-bottom:6px;"></div>
        <div id="viewUserRole" style="font-weight:700;font-size:15px;color:#111;margin-bottom:14px;"></div>
        <div class="admin-ban-modal-actions">
            <button type="button" id="viewUserClose" class="admin-action-btn view">Close</button>
        </div>
    </div>
</div>

<div id="banUserModal" class="admin-ban-modal" aria-hidden="true">
    <div class="admin-ban-modal-card" role="dialog" aria-modal="true" aria-labelledby="banModalTitle">
        <h3 id="banModalTitle">Reason for Banning</h3>

        <div class="admin-ban-reason-wrap">
            <select id="banReason" class="admin-ban-reason-select" aria-label="Reason for banning">
                <option value="">Select reason</option>
                <option value="Spam / Scam Activity">Spam / Scam Activity</option>
                <option value="Fraudulent Transactions">Fraudulent Transactions</option>
                <option value="Harassment / Abuse">Harassment / Abuse</option>
                <option value="Fake or Prohibited Listings">Fake or Prohibited Listings</option>
                <option value="Multiple Policy Violations">Multiple Policy Violations</option>
            </select>
        </div>

        <div class="admin-ban-modal-actions">
            <button type="button" id="banModalConfirm" class="admin-action-btn ban">Ban</button>
            <button type="button" id="banModalCancel" class="admin-action-btn admin-cancel-btn">Cancel</button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var listEl = document.getElementById('activeUsersList');
            var modal = document.getElementById('banUserModal');
            var viewModal = document.getElementById('viewUserModal');
            var reasonSelect = document.getElementById('banReason');
            var cancelBtn = document.getElementById('banModalCancel');
            var confirmBtn = document.getElementById('banModalConfirm');
            var viewCloseBtn = document.getElementById('viewUserClose');
            var activeUserName = '';
            var activeCard = null;

            function post(url, payload, done) {
                var form = new URLSearchParams();
                form.append('__RequestVerificationToken', token);
                Object.keys(payload || {}).forEach(function (k) { form.append(k, payload[k]); });
                fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: form.toString() })
                    .then(function (r) { return r.json(); })
                    .then(done);
            }

            function openViewModal(card) {
                if (!card || !viewModal) {
                    return;
                }

                var name = card.getAttribute('data-user-name') || card.querySelector('.admin-user-name').textContent.trim();
                var role = card.getAttribute('data-user-role') || card.querySelector('.admin-user-role').textContent.trim();
                var avatar = card.getAttribute('data-avatar-url') || '';

                document.getElementById('viewUserName').textContent = name;
                document.getElementById('viewUserRole').textContent = role;
                document.getElementById('viewUserAvatar').src = avatar;
                viewModal.classList.add('active');
                viewModal.setAttribute('aria-hidden', 'false');
            }

            function closeViewModal() {
                if (!viewModal) {
                    return;
                }
                viewModal.classList.remove('active');
                viewModal.setAttribute('aria-hidden', 'true');
            }

            function openModal(userName, card) {
                activeUserName = userName || '';
                activeCard = card || null;
                reasonSelect.value = '';
                modal.classList.add('active');
                modal.setAttribute('aria-hidden', 'false');
            }

            function closeModal() {
                modal.classList.remove('active');
                modal.setAttribute('aria-hidden', 'true');
            }

            function bindRowActions() {
                listEl.querySelectorAll('.admin-action-btn.ban[data-user-name]').forEach(function (button) {
                    button.addEventListener('click', function () {
                        openModal(button.getAttribute('data-user-name'), button.closest('.admin-user-card'));
                    });
                });

                listEl.querySelectorAll('.admin-action-btn.view').forEach(function (button) {
                    button.addEventListener('click', function () {
                        openViewModal(button.closest('.admin-user-card'));
                    });
                });
            }

            function render(users) {
                listEl.innerHTML = '';
                users.forEach(function (u) {
                    var card = document.createElement('div');
                    card.className = 'admin-user-card';
                    card.setAttribute('data-user-name', u.username);
                    card.setAttribute('data-user-role', u.role);
                    card.setAttribute('data-avatar-url', u.avatar);
                    card.setAttribute('data-user-id', u.userId);
                    card.innerHTML =
                        '<div class=\"admin-user-left\">' +
                        '  <img class=\"admin-user-avatar\" src=\"' + u.avatar + '\" alt=\"' + u.username + '\" />' +
                        '  <div class=\"admin-user-info\"><div class=\"admin-user-name\">' + u.username + '</div><div class=\"admin-user-role\">' + u.role + '</div></div>' +
                        '</div>' +
                        '<div class=\"admin-user-actions\">' +
                        '  <button type=\"button\" class=\"admin-action-btn view\">View</button>' +
                        '  <button type=\"button\" class=\"admin-action-btn ban\" data-user-name=\"' + u.username + '\">Ban</button>' +
                        '</div>';
                    listEl.appendChild(card);
                });
                bindRowActions();
            }

            function refresh() {
                fetch('@Url.Action("GetActiveUsers","Admin")')
                    .then(function (r) { return r.json(); })
                    .then(function (data) { render(data.users || []); });
            }

            cancelBtn.addEventListener('click', closeModal);
            if (viewCloseBtn) {
                viewCloseBtn.addEventListener('click', closeViewModal);
            }

            modal.addEventListener('click', function (event) {
                if (event.target === modal) {
                    closeModal();
                }
            });

            if (viewModal) {
                viewModal.addEventListener('click', function (event) {
                    if (event.target === viewModal) {
                        closeViewModal();
                    }
                });
            }

            confirmBtn.addEventListener('click', function () {
                var reason = reasonSelect.value;

                if (!reason) {
                    if (window.themeToast) {
                        window.themeToast('Please select a ban reason first.', 'warn');
                    }
                    return;
                }

                var userId = activeCard ? activeCard.getAttribute('data-user-id') : '';
                post('@Url.Action("BanUser","Admin")', { userId: userId, reason: reason }, function (res) {
                    if (!res.ok) {
                        if (window.themeToast) window.themeToast(res.message || 'Failed to ban user.', 'warn');
                        return;
                    }
                    closeModal();
                    if (window.themeToast) window.themeToast(activeUserName + ' moved to banned list.', 'success');
                    refresh();
                });
            });

            refresh();
        })();
    </script>
}
