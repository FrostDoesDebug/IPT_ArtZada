    <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/Site.css" />
    <style>
        @@font-face {
            font-family: 'Rushon Ground';
            src: url('/Content/Font/Rushon Ground.ttf') format('truetype');
        }

        :root {
            --red: #BF4646;
            --cream: #EDDCC6;
            --panel: #7EACB5;
            --green: #5DDB44;
            --orange: #D88628;
            --teal: #276470;
            --brown: #8C571C;
            --lime: #DDFA36;
            --white: #FFFFFF;
            --dark: #000000;
            --bw: 5px;
            --border: #1a1a1a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;
            overflow-y: auto;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
        }

        body {
            background: #EDDCC6 url('/Content/images/paperbg.png') no-repeat center center fixed;
            background-size: cover;
            color: #333;
        }

        /* ══ NAVBAR ══ */
        .navbar-container {
            background: #BF4646;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 50px;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 9998;
            width: 100%;
        }

        .nav-logo {
            position: absolute;
            left: 20px;
            display: flex;
            align-items: center;
        }

            .nav-logo svg {
                width: 44px;
                height: 28px;
            }

        .navbar {
            display: flex;
            gap: 50px;
        }

            .navbar a {
                color: rgba(255,255,255,0.8);
                font-family: 'Poppins', sans-serif;
                font-weight: 600;
                text-decoration: none;
                text-transform: uppercase;
                font-size: 14px;
                letter-spacing: 1px;
                transition: 0.3s;
                cursor: pointer;
            }

                .navbar a:hover {
                    color: white;
                }

                .navbar a.active {
                    color: white;
                    border-bottom: 3px solid white;
                    padding-bottom: 2px;
                }

        /* ══ BELL — protrudes below nav ══ */
        .nav-bell {
            position: absolute;
            right: 0;
            top: 0;
            width: 80px;
            height: 78px;
            background: #BF4646;
            border-bottom-left-radius: 18px;
            border-bottom-right-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: filter 0.15s;
            z-index: 20;
            text-decoration: none;
        }

            .nav-bell:hover {
                filter: brightness(1.15);
            }

            .nav-bell img {
                width: 46px;
                height: 46px;
                object-fit: contain;
                margin-top: 20px;
                animation: ring 2.5s ease-in-out infinite;
                transform-origin: top center;
            }

        @@keyframes ring {
            0%, 100% {
                transform: rotate(0deg);
            }

            10% {
                transform: rotate(14deg);
            }

            20% {
                transform: rotate(-12deg);
            }

            30% {
                transform: rotate(9deg);
            }

            40% {
                transform: rotate(-6deg);
            }

            50% {
                transform: rotate(0deg);
            }
        }

        .nav-bell .bdg {
            position: absolute;
            top: 8px;
            right: 6px;
            background: #D88628;
            color: white;
            border-radius: 50%;
            width: 20px;
            height: 20px;
            font-size: 10px;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid white;
        }

        /* ══ PAGE WRAP ══ */
        .page-wrap {
            margin-top: 50px;
            width: 100%;
            height: calc(100vh - 50px);
            padding: 24px clamp(12px, 2.2vw, 36px);
            overflow: visible;
            display: flex;
            flex-direction: column;
        }

        @@media (max-width: 900px) {
            .navbar {
                gap: 18px;
            }

            .navbar a {
                font-size: 13px;
            }

            .nav-bell {
                width: 64px;
                height: 64px;
            }

            .nav-bell img {
                width: 34px;
                height: 34px;
                margin-top: 14px;
            }

            #np {
                width: min(92vw, 340px);
            }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body data-page="@ViewBag.Page" data-nav-mode="@(((ViewBag.NavMode as string) ?? "client").ToLowerInvariant())">

    <!-- NAVBAR -->
    <div class="navbar-container">

        <!-- Back/Forward arrows -->
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white"
                         style="cursor:pointer" onclick="history.back()" />
                <polygon points="26,4  42,14  26,24" fill="white"
                         style="cursor:pointer" onclick="history.forward()" />
            </svg>
        </div>

        <!-- Nav links — black inactive, white active -->
        @{
            var navMode = ((ViewBag.NavMode as string) ?? "default").ToLowerInvariant();
            var isSellerNav = navMode == "seller";
            var navController = isSellerNav ? "Seller" : "Client";
        }
        <nav class="navbar">
            @if (isSellerNav)
            {
                <a href="@Url.Action("Store", navController)"
                   class="@(ViewBag.Page=="store" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Store", navController)'); return false;">Store</a>
                <a href="@Url.Action("Message", navController)"
                   class="@(ViewBag.Page=="message" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Message", navController)'); return false;">Message</a>
                <a href="@Url.Action("Analytics", navController)"
                   class="@(ViewBag.Page=="analytics" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Analytics", navController)'); return false;">Analytics</a>
                <a href="@Url.Action("Account", navController)"
                   class="@(ViewBag.Page=="account" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Account", navController)'); return false;">Account</a>
            }
            else
            {
                <a href="@Url.Action("Index", navController)"
                   class="@(ViewBag.Page=="store" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Index", navController)'); return false;">Store</a>
                <a href="@Url.Action("Message", navController)"
                   class="@(ViewBag.Page=="message" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Message", navController)'); return false;">Message</a>
                <a href="@Url.Action("Analytics", navController)"
                   class="@(ViewBag.Page=="analytics" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Analytics", navController)'); return false;">Analytics</a>
                <a href="@Url.Action("Account", navController)"
                   class="@(ViewBag.Page=="account" ? "active" : "")"
                   onclick="navigateTo('@Url.Action("Account", navController)'); return false;">Account</a>
            }
        </nav>

        <!-- ──────────────────────────────────────
             BELL BUTTON
             FIX: was only showing the popup, never going to the page.
             Now it does BOTH — shows popup AND navigates.

             ► To show popup only (no navigation):
               onclick="npToggle(); return false;"

             ► To navigate only (no popup):
               onclick="navigateTo('/Home/Notifications'); return false;"

             ► Current: does both (popup + navigate):
               onclick="npToggle(); navigateTo('/Home/Notifications'); return false;"
             ────────────────────────────────────── -->
        <a class="nav-bell" href="#"
           onclick="npToggle(); navigateTo('@Url.Action("Notifications", navController)'); return false;">
            <img src="/Content/images/notification.png" alt="Notifications"
                 onerror="this.outerHTML='<span style=\'font-size:28px;margin-top:20px\'>&#128276;</span>'" />
            <span class="bdg">3</span>
        </a>

    </div>

    <!-- Page label -->
    @if (!string.IsNullOrEmpty(ViewBag.PageLabel as string))
    {
        <div style="position:absolute;top:52px;left:4px;font-size:11px;color:#555;padding:1px 8px;z-index:5;">
            @ViewBag.PageLabel
        </div>
    }

    <!-- Page content -->
    <div class="page-wrap">
        @RenderBody()
    </div>

    <!-- NOTIFICATION POPUP -->
    <style>
        #np {
            position: fixed;
            top: 70px;
            right: 0;
            width: 340px;
            background: var(--panel);
            border: var(--bw) solid var(--border);
            border-right: none;
            border-radius: 12px 0 0 12px;
            z-index: 8000;
            box-shadow: -4px 6px 20px rgba(0,0,0,.3);
            transform: translateX(360px);
            opacity: 0;
            transition: transform .4s cubic-bezier(.22,1,.36,1), opacity .3s;
            pointer-events: none;
            overflow: hidden;
            max-height: calc(100vh - 82px);
        }

            #np.show {
                transform: translateX(0);
                opacity: 1;
                pointer-events: auto;
            }

        .np-label {
            background: var(--cream);
            border-bottom: var(--bw) solid var(--border);
            font-size: 11px;
            font-weight: 800;
            color: var(--dark);
            padding: 6px 12px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-family: 'Poppins', sans-serif;
            letter-spacing: .5px;
        }

        .np-x {
            background: none;
            border: none;
            font-size: 16px;
            font-weight: 900;
            cursor: pointer;
            color: var(--dark);
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .np-body {
            padding: 10px 12px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .np-search {
            display: flex;
            align-items: center;
            background: var(--orange);
            border: var(--bw) solid var(--border);
            border-radius: 10px;
            height: 52px;
            padding: 0 10px;
            gap: 8px;
        }

            .np-search input {
                flex: 1;
                background: var(--white);
                border: none;
                border-radius: 6px;
                height: 34px;
                padding: 0 10px;
                font-family: 'Poppins', sans-serif;
                font-size: 13px;
                font-weight: 700;
                color: var(--dark);
                outline: none;
            }

        .np-item {
            display: flex;
            align-items: center;
            gap: 10px;
            border-radius: 10px;
            border: var(--bw) solid var(--border);
            height: 72px;
            padding: 0 10px;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Poppins', sans-serif;
            background: var(--panel);
            color: var(--dark);
        }

            .np-item.warn {
                background: var(--red);
                color: var(--white);
            }

        .np-ic {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 50%;
            border: var(--bw) solid var(--border);
            background: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

            .np-ic img {
                width: 26px;
                height: 26px;
                object-fit: contain;
                filter: brightness(0) invert(1);
            }

        .np-item.warn .np-ic {
            background: rgba(0,0,0,.15);
            border-color: rgba(255,255,255,.4);
        }

        @@media (max-width: 900px) {
            #np {
                top: 60px;
                right: 8px;
                width: min(92vw, 340px);
                border-right: var(--bw) solid var(--border);
                border-radius: 12px;
                transform: translateY(-12px);
                max-height: calc(100vh - 78px);
                overflow-y: auto;
            }

                #np.show {
                    transform: translateY(0);
                }

            .np-item {
                height: auto;
                min-height: 64px;
                padding: 10px;
            }
        }

        .theme-toast {
            position: fixed;
            left: 50%;
            bottom: 18px;
            transform: translateX(-50%) translateY(12px);
            min-width: 220px;
            max-width: min(92vw, 560px);
            padding: 11px 16px;
            border: 3px solid #1a1a1a;
            border-radius: 10px;
            background: #276470;
            color: #fff;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: .3px;
            box-shadow: 0 8px 22px rgba(0,0,0,.35);
            opacity: 0;
            pointer-events: none;
            transition: opacity .18s ease, transform .18s ease;
            z-index: 9000;
            text-align: center;
        }

            .theme-toast.show {
                opacity: 1;
                transform: translateX(-50%) translateY(0);
            }

            .theme-toast.success {
                background: #2c8f48;
            }

            .theme-toast.warn {
                background: #BF4646;
            }

        .theme-confirm-backdrop {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.5);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9500;
            padding: 18px;
        }

            .theme-confirm-backdrop.show {
                display: flex;
            }

        .theme-confirm-card {
            width: min(92vw, 420px);
            background: #7EACB5;
            border: 4px solid #1a1a1a;
            border-radius: 16px;
            padding: 18px 16px;
            box-shadow: 0 8px 24px rgba(0,0,0,.3);
            text-align: center;
        }

        .theme-confirm-title {
            font-size: 20px;
            margin-bottom: 10px;
            color: #111;
            font-weight: 900;
        }

        .theme-confirm-message {
            font-size: 14px;
            color: #111;
            margin-bottom: 14px;
        }

        .theme-confirm-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

            .theme-confirm-actions button {
                min-width: 120px;
                border: 3px solid #111;
                border-radius: 10px;
                padding: 8px 10px;
                font-weight: 800;
                cursor: pointer;
            }

        .theme-confirm-ok {
            background: #69d84d;
            color: #111;
        }

        .theme-confirm-cancel {
            background: #BF4646;
            color: #fff;
        }
    </style>

    <div id="np">
        <div class="np-label">
            <span>Popup notification - Seller Side</span>
            <button class="np-x" onclick="npClose()">✕</button>
        </div>
        <div class="np-body">
            <div class="np-search">
                <img src="/Content/images/search.png"
                     style="width:24px;height:24px;object-fit:contain;flex-shrink:0;"
                     onerror="this.outerHTML='<span style=\'font-size:18px\'>🔍</span>'" />
                <input type="text" placeholder="Search Notification" />
            </div>
            <div class="np-item warn">
                <div class="np-ic">
                    <img src="/Content/images/warning.png"
                         onerror="this.outerHTML='<span style=\'font-size:20px\'>⚠️</span>'" />
                </div>
                <span>Warning: Only 3 pieces of Chubb remaining!</span>
            </div>
            <div class="np-item">
                <div class="np-ic">
                    <img src="/Content/images/message.png"
                         onerror="this.outerHTML='<span style=\'font-size:20px\'>👤</span>'" />
                </div>
                <span>Client#1 has replied to your message</span>
            </div>
            <div class="np-item">
                <div class="np-ic">
                    <img src="/Content/images/goods.png"
                         onerror="this.outerHTML='<span style=\'font-size:20px\'>✔️</span>'" />
                </div>
                <span>Chubb has been sold successfully!</span>
            </div>
        </div>
    </div>

    <div id="themeToast" class="theme-toast" role="status" aria-live="polite"></div>

    <div id="themeConfirm" class="theme-confirm-backdrop" aria-hidden="true">
        <div class="theme-confirm-card" role="dialog" aria-modal="true" aria-labelledby="themeConfirmTitle">
            <div id="themeConfirmTitle" class="theme-confirm-title">Confirm action</div>
            <div id="themeConfirmMessage" class="theme-confirm-message">Are you sure?</div>
            <div class="theme-confirm-actions">
                <button type="button" id="themeConfirmOk" class="theme-confirm-ok">Confirm</button>
                <button type="button" id="themeConfirmCancel" class="theme-confirm-cancel">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var el = document.getElementById('np');
            var t;
            var body = document.body;
            var currentPage = (body.getAttribute('data-page') || '').toLowerCase();
            var navMode = (body.getAttribute('data-nav-mode') || '').toLowerCase();
            var isSellerStorePage = navMode === 'seller' && currentPage === 'store';
            var onceKey = 'artzada-seller-store-popup-shown';

            function show() {
                if (!el) {
                    return;
                }
                el.classList.add('show');
                t = setTimeout(npClose, 7000);
            }

            window.npClose = function () {
                clearTimeout(t);
                if (el) {
                    el.classList.remove('show');
                }
            };

            if (isSellerStorePage && !localStorage.getItem(onceKey)) {
                setTimeout(show, 900);
                localStorage.setItem(onceKey, '1');
            }
        })();

        function npToggle() {
            var el = document.getElementById('np');
            el.classList.contains('show') ? npClose() : el.classList.add('show');
        }

        function navigateTo(url) {
            if (url && url !== '#' && url !== '')
                window.location.href = url;
        }

        (function () {
            var toastEl = document.getElementById('themeToast');
            var toastTimer = null;

            window.themeToast = function (message, kind) {
                if (!toastEl) {
                    return;
                }

                toastEl.textContent = message || '';
                toastEl.className = 'theme-toast ' + (kind || '');
                toastEl.classList.add('show');

                clearTimeout(toastTimer);
                toastTimer = setTimeout(function () {
                    toastEl.classList.remove('show');
                }, 2400);
            };

            var confirmEl = document.getElementById('themeConfirm');
            var confirmMsgEl = document.getElementById('themeConfirmMessage');
            var confirmOkEl = document.getElementById('themeConfirmOk');
            var confirmCancelEl = document.getElementById('themeConfirmCancel');
            var onConfirm = null;

            function closeConfirm() {
                if (!confirmEl) {
                    return;
                }
                confirmEl.classList.remove('show');
                confirmEl.setAttribute('aria-hidden', 'true');
                onConfirm = null;
            }

            window.themeConfirm = function (message, confirmCallback) {
                if (!confirmEl || !confirmMsgEl) {
                    return;
                }

                confirmMsgEl.textContent = message || 'Are you sure?';
                onConfirm = typeof confirmCallback === 'function' ? confirmCallback : null;
                confirmEl.classList.add('show');
                confirmEl.setAttribute('aria-hidden', 'false');
            };

            if (confirmOkEl) {
                confirmOkEl.addEventListener('click', function () {
                    var cb = onConfirm;
                    closeConfirm();
                    if (cb) {
                        cb();
                    }
                });
            }

            if (confirmCancelEl) {
                confirmCancelEl.addEventListener('click', closeConfirm);
            }

            if (confirmEl) {
                confirmEl.addEventListener('click', function (ev) {
                    if (ev.target === confirmEl) {
                        closeConfirm();
                    }
                });
            }
        })();
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
