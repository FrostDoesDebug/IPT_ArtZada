@{
    ViewBag.Title = "Account";
    ViewBag.Page = "account";
    ViewBag.PageLabel = "Account";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var username = (string)(ViewBag.Username) ?? "PAMILI IS LOVE";
    var isSeller = (bool)(ViewBag.IsSeller ?? true);
}

@section Styles {
    <link href="@Url.Content("~/Content/CSS/Account.css")" rel="stylesheet" />
}

<div class="account-card">
    @Html.AntiForgeryToken()
    <div class="save-cancel-group hidden" id="editControls">
        <button class="btn-save" onclick="saveChanges()">Save Changes</button>
        <button class="btn-cancel-sm" onclick="cancelEdit()">Cancel</button>
    </div>
    <div class="account-header">

        <!-- Hidden file input for Change Profile -->
        <input type="file"
               id="profileFileInput"
               accept="image/*"
               class="profile-file-input"
               onchange="handleProfileImage(this)" />

        <div class="profile-avatar" onclick="changeProfile()" title="Click to change photo">
            @if (!string.IsNullOrEmpty(ViewBag.ProfileImageUrl as string))
            {
                <img src="@ViewBag.ProfileImageUrl" alt="Profile" />
            }
            else
            {
                <svg viewBox="0 0 80 80" fill="#555" class="profile-avatar-fallback">
                    <circle cx="40" cy="28" r="18" />
                    <path d="M8 72c0-18 64-18 64 0" />
                </svg>
            }
        </div>
        <div class="profile-name" id="profileName">@username</div>
    </div>
    <div class="account-actions">
        <button class="btn-action" onclick="editUsername()">Edit Username</button>
        <button class="btn-action" onclick="changeProfile()">Change Profile</button>
        <button class="btn-action" onclick="switchAccount()">
            @(isSeller ? "Switch to Buyer' Account" : "Switch to Seller' Account")
        </button>
    </div>
    <div id="accountStatus" style="margin-top:10px;font-size:13px;color:#666;"></div>
    <a href="/Login/Logout" class="btn-signout"
       onclick="return confirm('Are you sure you want to sign out?')">Sign Out</a>
</div>

@section Scripts {
    <script type="text/javascript">
        var editing = false;
        var originalName = '';

        /* ── Edit Username ── */
        function editUsername() {
            if (editing) return;
            editing = true;
            originalName = document.getElementById('profileName').textContent;
            document.getElementById('editControls').classList.remove('hidden');
            var nameEl = document.getElementById('profileName');
            nameEl.contentEditable = 'true';
            nameEl.focus();
            var range = document.createRange();
            range.selectNodeContents(nameEl);
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(range);
        }

        /* ── Save Changes ── */
        async function saveChanges() {
            editing = false;
            var nameEl = document.getElementById('profileName');
            var statusEl = document.getElementById('accountStatus');
            var nextUsername = nameEl.textContent.trim();
            nameEl.contentEditable = 'false';
            document.getElementById('editControls').classList.add('hidden');

            if (!nextUsername) {
                nameEl.textContent = originalName;
                statusEl.textContent = 'Username cannot be empty.';
                statusEl.style.color = '#b3261e';
                return;
            }

            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var form = new URLSearchParams();
            form.append('__RequestVerificationToken', token);
            form.append('username', nextUsername);

            statusEl.textContent = 'Saving...';
            statusEl.style.color = '#666';

            try {
                var response = await fetch('/Home/UpdateUsername', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: form.toString()
                });

                var data = await response.json();
                if (!response.ok || !data.ok) {
                    nameEl.textContent = originalName;
                    statusEl.textContent = data.message || 'Failed to save username.';
                    statusEl.style.color = '#b3261e';
                    return;
                }

                nameEl.textContent = data.username || nextUsername;
                originalName = nameEl.textContent;
                statusEl.textContent = data.message || 'Saved.';
                statusEl.style.color = '#1b7f3b';
            } catch (e) {
                nameEl.textContent = originalName;
                statusEl.textContent = 'Network error while saving username.';
                statusEl.style.color = '#b3261e';
            }
        }

        /* ── Cancel Edit — restores original name ── */
        function cancelEdit() {
            editing = false;
            var nameEl = document.getElementById('profileName');
            nameEl.contentEditable = 'false';
            nameEl.textContent = originalName;
            document.getElementById('editControls').classList.add('hidden');
        }

        /* ── Change Profile — opens file picker ── */
        function changeProfile() {
            document.getElementById('profileFileInput').click();
        }

        /* ── Handle selected profile image ── */
        function handleProfileImage(input) {
            var file = input.files[0];
            if (!file) return;

            var reader = new FileReader();
            reader.onload = function (e) {
                /* Replace avatar content with selected image */
                var avatar = document.querySelector('.profile-avatar');
                avatar.innerHTML = '<img src="' + e.target.result +
                    '" alt="Profile" class="profile-avatar-img" />';
            };
            reader.readAsDataURL(file);
            input.value = ''; /* reset so same image can be picked again */
        }

        /* ── Switch Account ── */
        function switchAccount() {
            window.location.href = '/Home/ToggleSeller';
        }
    </script>
}
