@{
    ViewBag.Title = "Banned Listed";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-users-wrap">
    @Html.AntiForgeryToken()
    <div class="admin-users-panel">
        <h2 class="admin-panel-title">Banned Listed</h2>
        <p class="admin-panel-subtitle" id="bannedSubtitle">Users moved to banned list will appear here.</p>
        <div id="bannedUsersList"></div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var listEl = document.getElementById('bannedUsersList');
            var subtitleEl = document.getElementById('bannedSubtitle');

            function post(url, payload, done) {
                var form = new URLSearchParams();
                form.append('__RequestVerificationToken', token);
                Object.keys(payload || {}).forEach(function (k) { form.append(k, payload[k]); });
                fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' }, body: form.toString() })
                    .then(function (r) { return r.json(); })
                    .then(done);
            }

            function formatDate(isoText) {
                if (!isoText) {
                    return 'Unknown date';
                }
                var date = new Date(isoText);
                return date.toLocaleString();
            }

            function render() {
                fetch('@Url.Action("GetBannedUsers","Admin")')
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        var users = data.users || [];
                        listEl.innerHTML = '';

                        if (!users.length) {
                            subtitleEl.textContent = 'No banned users yet.';
                            return;
                        }

                        subtitleEl.textContent = users.length + ' banned user(s).';

                        users.forEach(function (user) {
                    var card = document.createElement('div');
                    card.className = 'admin-user-card';
                    card.innerHTML =
                        '<div class="admin-user-left">' +
                        '  <img class="admin-user-avatar" src="' + (user.avatar || '@Url.Content("~/Content/images/artzada_logo.png")') + '" alt="' + (user.username || 'User') + '" />' +
                        '  <div class="admin-user-info" style="display:block;">' +
                        '    <div class="admin-user-name">' + (user.username || 'Unknown User') + '</div>' +
                        '    <div class="admin-user-role">' + (user.role || 'User') + '</div>' +
                        '    <div style="font-size:13px;font-weight:700;margin-top:4px;">Reason: ' + (user.reason || 'Not specified') + '</div>' +
                        '  </div>' +
                        '</div>' +
                        '<div class="admin-user-actions">' +
                        '  <button type="button" class="admin-action-btn accept" data-id="' + user.userId + '" data-name="' + user.username + '">Unban</button>' +
                        '</div>';

                    listEl.appendChild(card);
                });

                listEl.querySelectorAll('.admin-action-btn.accept[data-id]').forEach(function (btn) {
                    btn.addEventListener('click', function () {
                        var id = btn.getAttribute('data-id');
                        var userName = btn.getAttribute('data-name') || 'User';

                        if (window.themeConfirm) {
                            window.themeConfirm('Unban ' + userName + '?', function () {
                                post('@Url.Action("UnbanUser","Admin")', { userId: id }, function (res) {
                                    if (!res.ok) return;
                                    render();
                                    if (window.themeToast) window.themeToast(userName + ' has been unbanned.', 'success');
                                });
                            });
                        }
                    });
                });
                    });
            }

            render();
        })();
    </script>
}
