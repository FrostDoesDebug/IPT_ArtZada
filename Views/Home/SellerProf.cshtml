@{ ViewBag.Title = "SellerProf"; Layout = null; }

<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Seller Profile</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/Content/SellerProf.css" />

    <style>
        .navbar-container {
            top: 0;
        }

        body {
            padding-top: 60px;
        }
    </style>
</head>

<body>

        <!-- NAVBAR -->
        @{
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        }
        <div class="navbar-container">
            <div class="nav-arrows">
                <button class="nav-btn">&#9664;</button>
                <button class="nav-btn">&#9654;</button>
            </div>

            <div class="navbar">
                <a href="/Home/Index" class="@(currentAction == "Index" ? "active" : "")">Home</a>
                <a href="#hotSales">Shop</a>
                <a href="/Home/Message" class="@(currentAction == "Message" ? "active" : "")">Message</a>
                <a href="/Home/Cart" class="@(currentAction == "Cart" ? "active" : "")">Cart</a>
                <a href="/Home/Account" class="@(currentAction == "Account" ? "active" : "")">Account</a>
            </div>
        </div>
    </div>
        <!-- PROFILE HEADER -->
        <div class="profile-header">
            <div class="profile-box">
                <div class="profile-left">
                    <img class="profile-pic" src="~/images/profile.jpg" />
                    <h1>KWEKKWEKSASTIX</h1>
                </div>
                

                <button class="message-btn">✉ Send Message!</button>
            </div>
        </div>

        <!-- ARTWORKS -->
        <div class="artworks-section">
            <h2 class="art-title">ARTWORKS</h2>

            <div class="art-grid">
                <div class="art-card">
                    <img src="~/images/dog.jpg" />
                    <h3>CHUBB</h3>
                    <p>Digital Print</p>
                    <span class="price">₱100.00</span>
                </div>

                <div class="art-card empty"></div>
                <div class="art-card empty"></div>
                <div class="art-card empty"></div>
            </div>
        </div>
    </div>
</body>
</html>
