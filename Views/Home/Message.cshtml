@{
    ViewBag.Title = "Messages";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Messages</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="nav-arrows">
            <button class="nav-btn">&#9664;</button>
            <button class="nav-btn">&#9654;</button>
        </div>

        <div class="navbar">
            <a href="/Home/Index"
               class="@(currentAction == "Index" ? "active" : "")">Home</a>

            <a href="/Home/Index"
               class="@(currentAction == "Shop" ? "active" : "")">Shop</a>

            <a href="/Home/Message"
               class="@(currentAction == "Message" ? "active" : "")">Message</a>

            <a href="/Home/Cart"
               class="@(currentAction == "Cart" ? "active" : "")">Cart</a>

            <a href="/Home/Account"
               class="@(currentAction == "Account" ? "active" : "")">Account</a>
        </div>
    </div>

    <div class="message-layout">

        <!-- LEFT PANEL -->
        <div class="message-sidebar">

            <div class="sidebar-header">
                <div class="profile">
                    <div class="profile-pic"></div>
                    <strong>Chats</strong>
                </div>
            </div>

            <!-- USERS -->
            <div class="sidebar-user" onclick="loadChat('User 1')">
                <div class="profile-pic small"></div>
                <span>User 1</span>
            </div>

            <div class="sidebar-user" onclick="loadChat('User 2')">
                <div class="profile-pic small"></div>
                <span>User 2</span>
            </div>

        </div>

        <!-- CHAT PANEL -->
        <div class="chat-panel">

            <!-- HEADER -->
            <div class="chat-header">
                <div class="profile">
                    <div class="profile-pic"></div>
                    <strong id="chatName">KWEKKWEKSASTIX</strong>
                </div>
            </div>

            <!-- CHAT -->
            <div class="chat-body" id="chatBody">
                <!-- Messages will load here -->
            </div>

            <!-- INPUT -->
            <div class="chat-input">

                <label class="attach-btn">
                    📎
                    <input type="file" accept="image/png" hidden />
                </label>

                <input type="text" id="messageInput" placeholder="Ayos" />
                <button onclick="sendMessage()">Send</button>
            </div>

        </div>
    </div>
    <script src="~/Scripts/site.js"></script>
</body>
</html>