@{
    ViewBag.Title = "Analytics";
    ViewBag.Page = "analytics";
    ViewBag.PageLabel = "Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/CSS/Analytics.css")" rel="stylesheet" />
}

<div class="analytics-layout">

    <!-- MONTH NAVIGATOR -->
    <div class="analytics-month-nav">
        <button class="month-arrow" id="prevMonth">&#9664;</button>
        <span class="month-label-text" id="monthLabel">JANUARY</span>
        <button class="month-arrow" id="nextMonth">&#9654;</button>
    </div>

    <!-- 3-COLUMN GRID -->
    <div class="analytics-grid">

        <!-- LEFT: Revenue + Due Dates -->
        <div class="analytics-left">

            <div class="revenue-box">
                <div class="revenue-label">TOTAL REVENUE</div>
                <div class="revenue-amount">&#8369;@(ViewBag.TotalRevenue ?? "100.00")</div>
            </div>

            <div class="duedates-box">
                <div class="duedates-label">DUEDATES</div>
                <div class="duedate-row">
                    <span>Client #1</span>
                    <span>January 13</span>
                </div>
                <div class="duedate-empty"></div>
            </div>

        </div>

        <!-- CENTER: Chart -->
        <div class="chart-box">
            <canvas id="revenueChart"></canvas>
        </div>

        <!-- RIGHT: Stocks -->
        <div class="stocks-box">
            <div class="stocks-label">STOCKS</div>
            <div class="stock-row red">   <span>Chubb</span>   <span>x3</span>  </div>
            <div class="stock-row green"> <span>Boss</span>    <span>x10</span> </div>
            <div class="stock-row lime">  <span>Drawing</span> <span>x5</span>  </div>
            <div class="stock-row empty"></div>
            <div class="stock-row empty"></div>
            <div class="stock-row empty"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script type="text/javascript">

        // ── Month navigation data ──
        var months = [
            'JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE',
            'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'
        ];
        var currentMonth = 0;

        // Sample weekly revenue data per month
        var weekData = [
            [9, 17, 21, 33],  // January
            [5, 12, 18, 25],  // February
            [8, 14, 22, 30],  // March
            [6, 11, 19, 28],  // April
            [10, 16, 24, 35], // May
            [7, 13, 20, 29],  // June
            [4, 9, 15, 22],   // July
            [8, 12, 18, 26],  // August
            [11, 17, 23, 31], // September
            [6, 10, 16, 24],  // October
            [9, 15, 21, 32],  // November
            [12, 20, 28, 38]  // December
        ];

        document.getElementById('prevMonth').addEventListener('click', function () {
            currentMonth = (currentMonth - 1 + 12) % 12;
            document.getElementById('monthLabel').textContent = months[currentMonth];
            chart.data.datasets[0].data = weekData[currentMonth];
            chart.update('active');
        });

        document.getElementById('nextMonth').addEventListener('click', function () {
            currentMonth = (currentMonth + 1) % 12;
            document.getElementById('monthLabel').textContent = months[currentMonth];
            chart.data.datasets[0].data = weekData[currentMonth];
            chart.update('active');
        });

        // ── Chart.js line chart ──
        var ctx = document.getElementById('revenueChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                datasets: [{
                    label: 'Revenue',
                    data: weekData[0],
                    borderColor: '#BF4646',
                    backgroundColor: 'rgba(191,70,70,0.08)',
                    pointBackgroundColor: '#BF4646',
                    pointBorderColor: '#BF4646',
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    borderWidth: 2.5,
                    tension: 0.15,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            font: { family: 'Poppins', weight: 'bold', size: 28 },
                            color: '#1a1a1a',
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    }
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Weeks',
                            font: { family: 'Poppins', weight: 'bold', size: 32 },
                            color: '#1a1a1a'
                        },
                        ticks: { font: { family: 'Poppins', weight: '700', size: 28 }, color: '#1a1a1a' },
                        grid: { color: 'rgba(0,0,0,0.08)' }
                    },
                    y: {
                        title: {
                            display: true,
                            text: 'Sales',
                            font: { family: 'Poppins', weight: 'bold', size: 32 },
                            color: '#1a1a1a'
                        },
                        ticks: { font: { family: 'Poppins', weight: '700', size: 28 }, color: '#1a1a1a' },
                        grid: { color: 'rgba(0,0,0,0.08)' },
                        min: 0
                    }
                }
            }
        });
    </script>
}
