<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ArtZada</title>
    @Styles.Render("~/Content/css")
    <style>
        body.auth-body {
            background: #EDDCC6 url('/Content/images/paperbg.png') no-repeat center center fixed;
            background-size: cover;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="auth-body">
    <div class="auth-page @(ViewBag.PageClass ?? "")">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script>
        (function () {
            var adminLandingUrl = '@Url.Action("Enable", "Admin")';
            var path = (window.location.pathname || '').toLowerCase();
            if (path.indexOf('/admin') !== -1) {
                return;
            }

            var ctrlDown = false;
            var eDown = false;
            var timerId = null;

            function clearTimer() {
                if (timerId) {
                    clearTimeout(timerId);
                    timerId = null;
                }
            }

            function tryStartTimer() {
                if (timerId || !ctrlDown || !eDown) {
                    return;
                }

                timerId = setTimeout(function () {
                    if (ctrlDown && eDown) {
                        window.location.href = adminLandingUrl;
                    }
                }, 3000);
            }

            window.addEventListener('keydown', function (ev) {
                var key = ev.key || '';
                if (key === 'Control') {
                    ctrlDown = true;
                    tryStartTimer();
                    return;
                }

                if ((ev.ctrlKey || ctrlDown) && (key === 'e' || key === 'E' || ev.code === 'KeyE')) {
                    ev.preventDefault();
                    ctrlDown = true;
                    eDown = true;
                    tryStartTimer();
                }
            }, true);

            window.addEventListener('keyup', function (ev) {
                var key = ev.key || '';
                if (key === 'Control') {
                    ctrlDown = false;
                    clearTimer();
                    return;
                }

                if (key === 'e' || key === 'E' || ev.code === 'KeyE') {
                    eDown = false;
                    clearTimer();
                }
            }, true);

            window.addEventListener('blur', function () {
                ctrlDown = false;
                eDown = false;
                clearTimer();
            });
        })();

        (function () {
            var page = document.querySelector('.auth-page');
            if (!page) {
                return;
            }

            var target = page.querySelector('.auth-card, .landing-wrapper');
            if (!target) {
                return;
            }

            var rafId = null;

            function fitToViewport() {
                target.style.transform = '';
                target.style.transformOrigin = 'center center';

                var rect = target.getBoundingClientRect();
                if (!rect.width || !rect.height) {
                    return;
                }

                var gutter = 12;
                var availableWidth = Math.max(0, window.innerWidth - (gutter * 2));
                var availableHeight = Math.max(0, window.innerHeight - (gutter * 2));
                var scale = Math.min(1, availableWidth / rect.width, availableHeight / rect.height);

                target.style.transform = 'scale(' + scale.toFixed(4) + ')';
            }

            function scheduleFit() {
                if (rafId !== null) {
                    window.cancelAnimationFrame(rafId);
                }

                rafId = window.requestAnimationFrame(function () {
                    rafId = null;
                    fitToViewport();
                });
            }

            window.addEventListener('resize', scheduleFit);
            window.addEventListener('orientationchange', scheduleFit);
            window.addEventListener('load', scheduleFit);

            var images = target.querySelectorAll('img');
            for (var i = 0; i < images.length; i++) {
                if (!images[i].complete) {
                    images[i].addEventListener('load', scheduleFit);
                }
            }

            if (document.fonts && document.fonts.ready) {
                document.fonts.ready.then(scheduleFit);
            }

            scheduleFit();
            setTimeout(scheduleFit, 100);
        })();
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>
