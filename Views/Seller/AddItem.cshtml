@{
    ViewBag.Title = "Add Item";
    ViewBag.Page = "store";
    ViewBag.NavMode = "seller";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/CSS/SellerSideStoreAddItem.css")" rel="stylesheet" />
}

    <div class="page-content">
        <div class="title-wrap">
            <div class="page-title">Add Item</div>
        </div>
        <div class="form-panel">
            <div class="photo-col">
                <div class="photo-box">
                    <img id="photoPreview" src="@Url.Content("~/Content/images/artzada_logo.png")" alt="Item Photo" />
                </div>
                <button class="btn-add-photo" type="button" onclick="document.getElementById('photoInput').click()">
                    Add Photo
                </button>
                <button class="btn-cancel-left" type="button" onclick="window.location.href='@Url.Action("Store","Seller")'">
                    Cancel
                </button>
                <input type="file" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(event)" />
            </div>
            <div class="fields-col">
                <div class="fields-row">
                    <div class="fields-inner">
                        <div class="field-group">
                            <label class="field-label">Name</label>
                            <input type="text" class="field-input" id="itemName" />
                        </div>
                        <div class="type-row">
                            <label class="field-label">Type</label>
                            <div class="type-select-wrap">
                                <select id="itemType">
                                    <option value=""></option>
                                    <option value="Digital Print">Digital Print</option>
                                    <option value="Sticker">Sticker</option>
                                    <option value="Poster">Poster</option>
                                    <option value="Canvas">Canvas</option>
                                    <option value="Commission">Commission</option>
                                </select>
                                <div class="dropdown-arrow">
                                    <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"></path></svg>
                                </div>
                            </div>
                        </div>
                        <div class="price-stock-row">
                            <div class="field-group">
                                <label class="field-label">Price</label>
                                <input type="number" class="field-input regular-font" id="itemPrice" placeholder="0.00" min="0" step="0.01" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Stocks</label>
                                <input type="number" class="field-input regular-font" id="itemStocks" placeholder="0" min="0" />
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Description</label>
                            <textarea class="field-textarea" id="itemDescription"></textarea>
                        </div>
                    </div>
                    <div class="right-actions">
                        <button class="btn-submit" type="button" onclick="submitItem()">Add Item</button>
                        <button class="btn-cancel-right" type="button" onclick="window.location.href='@Url.Action("Store","Seller")'">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

@section Scripts {
    <script>
        var currentPhotoData = '/Content/images/artzada_logo.png';

        function previewPhoto(event) {
            var file = event.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (e) {
                currentPhotoData = e.target.result;
                document.getElementById('photoPreview').src = currentPhotoData;
            };
            reader.readAsDataURL(file);
        }

        function submitItem() {
            var name  = document.getElementById('itemName').value.trim();
            var type  = document.getElementById('itemType').value;
            var price = document.getElementById('itemPrice').value;
            var stocks = document.getElementById('itemStocks').value;
            var desc  = document.getElementById('itemDescription').value.trim();

            if (!name)   { if (window.themeToast) window.themeToast('Please enter a name.', 'warn'); return; }
            if (!type)   { if (window.themeToast) window.themeToast('Please select a type.', 'warn'); return; }
            if (!price)  { if (window.themeToast) window.themeToast('Please enter a price.', 'warn'); return; }
            if (!stocks) { if (window.themeToast) window.themeToast('Please enter a stock amount.', 'warn'); return; }

            var items = JSON.parse(localStorage.getItem('sellerItems') || '[]');
            var newItem = {
                id: Date.now().toString(),
                name: name,
                type: type,
                price: price,
                stocks: stocks,
                description: desc,
                photo: currentPhotoData
            };
            items.push(newItem);
            localStorage.setItem('sellerItems', JSON.stringify(items));
            if (window.themeToast) window.themeToast('Item added successfully.', 'success');

            window.location.href = '@Url.Action("Store","Seller")';
        }
    </script>
}
