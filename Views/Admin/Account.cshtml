@{
    ViewBag.Title = "Account";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var adminUser = (Session["AdminUserName"] as string) ?? "admin";
}

@section Styles {
    <style>
        .admin-account-shell {
            width: min(100%, 980px);
            margin: 0 auto;
            background: #2C6A73;
            border: 4px solid #111;
            border-radius: 22px;
            padding: 20px;
        }

        .admin-page-wrap {
            overflow: hidden;
            display: flex;
            flex-direction: column;
            height: calc(100vh - 50px);
            padding: 8px clamp(8px, 1.2vw, 16px);
        }

        .admin-page-wrap .admin-users-wrap {
            flex: 1;
            min-height: 0;
            display: flex;
            align-items: flex-start;
            justify-content: center;
            overflow: auto;
        }

        .admin-header-actions {
            display: none;
            justify-content: flex-end;
            gap: 8px;
            margin-bottom: 10px;
        }

        .admin-account-shell.editing .admin-header-actions {
            display: flex;
        }

        .admin-account-top {
            display: grid;
            grid-template-columns: 130px 1fr;
            gap: 18px;
            align-items: center;
            margin-bottom: 16px;
        }

        .admin-avatar-wrap {
            width: 130px;
            height: 130px;
            border-radius: 50%;
            border: 4px solid #111;
            overflow: hidden;
            cursor: pointer;
            background: #fff;
        }

        .admin-avatar-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .admin-account-title {
            color: #fff;
            font-size: clamp(28px, 3vw, 46px);
            font-weight: 900;
            line-height: 1;
            margin-bottom: 6px;
        }

        .admin-account-subtitle {
            color: #f1f1f1;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .admin-username-display {
            color: #fff;
            font-size: clamp(34px, 5.2vw, 76px);
            line-height: 1;
            font-weight: 900;
            margin-bottom: 8px;
            font-family: 'RushonGround', 'Poppins', sans-serif;
            text-transform: uppercase;
        }

        .admin-inline-edit {
            display: none;
        }

        .admin-account-shell.editing .admin-inline-edit {
            display: flex;
        }

        .admin-inline-edit input {
            border: 3px solid #111;
            border-radius: 10px;
            padding: 8px 10px;
            font-weight: 700;
            width: min(100%, 320px);
        }

        .admin-pass-panel {
            display: none;
            margin-top: 10px;
            background: #8AB9C1;
            border: 3px solid #111;
            border-radius: 14px;
            padding: 14px;
        }

        .admin-account-shell.pass-edit .admin-pass-panel {
            display: block;
        }

        .admin-pass-panel h3 {
            margin: 0 0 10px;
            color: #111;
            font-weight: 900;
        }

        .admin-pass-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 10px;
            align-items: start;
        }

        .admin-pass-item {
            min-width: 0;
        }

        .admin-pass-item label {
            display: block;
            margin-bottom: 5px;
            font-size: 12px;
            font-weight: 800;
            color: #111;
        }

        .admin-pass-wrap {
            position: relative;
        }

        .admin-pass-wrap input {
            width: 100%;
            box-sizing: border-box;
            border: 3px solid #111;
            border-radius: 10px;
            padding: 8px 56px 8px 10px;
            font-weight: 700;
        }

        .admin-pass-wrap button {
            position: absolute;
            top: 50%;
            right: 6px;
            transform: translateY(-50%);
            border: 2px solid #111;
            border-radius: 8px;
            background: #EDDCC6;
            padding: 2px 8px;
            font-size: 11px;
            font-weight: 800;
        }

        .admin-account-actions {
            margin-top: 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
        }

        .admin-account-actions .admin-action-btn {
            min-width: 170px;
        }

        .admin-account-actions .admin-action-btn.ban {
            min-width: 160px;
        }

        #adminAvatarInput {
            display: none;
        }

        @@media (max-width: 860px) {
            .admin-pass-grid {
                grid-template-columns: 1fr;
            }

            .admin-account-top {
                grid-template-columns: 1fr;
                justify-items: center;
                text-align: center;
            }

            .admin-header-actions {
                justify-content: center;
            }

            .admin-account-actions {
                justify-content: center;
            }
        }

        @@media (max-width: 1024px) and (min-width: 760px) {
            .admin-page-wrap {
                overflow: hidden;
                padding: 6px 8px;
                height: calc(100vh - 50px);
            }

            .admin-account-shell {
                border-width: 3px;
                border-radius: 14px;
                padding: 14px 12px;
            }

            .admin-account-actions .admin-action-btn {
                min-width: 148px;
                padding: 8px 10px;
            }
        }

        @@media (max-width: 1366px) and (max-height: 768px) {
            .admin-account-shell {
                width: min(100%, 1020px);
                padding: 14px;
            }

            .admin-account-top {
                grid-template-columns: 104px 1fr;
                gap: 14px;
                margin-bottom: 10px;
            }

            .admin-avatar-wrap {
                width: 104px;
                height: 104px;
                border-width: 3px;
            }

            .admin-account-title {
                font-size: clamp(24px, 2.7vw, 34px);
                margin-bottom: 2px;
            }

            .admin-account-subtitle {
                font-size: 12px;
                margin-bottom: 6px;
            }

            .admin-username-display {
                font-size: clamp(38px, 4.2vw, 56px);
                margin-bottom: 5px;
            }

            .admin-pass-panel {
                padding: 10px;
            }

            .admin-pass-panel h3 {
                margin-bottom: 8px;
                font-size: 34px;
                line-height: 1;
            }

            .admin-pass-grid {
                gap: 8px;
            }

            .admin-pass-item label {
                font-size: 11px;
                margin-bottom: 4px;
            }

            .admin-pass-wrap input {
                height: 38px;
                padding: 6px 50px 6px 10px;
                font-size: 15px;
            }

            .admin-pass-wrap button {
                padding: 1px 7px;
                font-size: 10px;
            }
        }

        @@media (max-width: 760px), (max-height: 460px) {
            .admin-page-wrap {
                overflow-y: auto;
                height: auto;
                min-height: calc(100vh - 44px);
                padding: 10px 8px;
            }

            .admin-page-wrap .admin-users-wrap {
                overflow: visible;
                min-height: calc(100vh - 60px);
            }

            .admin-account-shell {
                border-width: 3px;
                border-radius: 16px;
                padding: 12px;
            }

            .admin-avatar-wrap {
                width: 92px;
                height: 92px;
                border-width: 3px;
            }

            .admin-account-title {
                font-size: clamp(18px, 3.8vw, 26px);
                margin-bottom: 2px;
            }

            .admin-account-subtitle {
                font-size: 12px;
                margin-bottom: 6px;
            }

            .admin-username-display {
                font-size: clamp(30px, 9.2vw, 54px);
                margin-bottom: 4px;
            }

            .admin-account-actions {
                margin-top: 10px;
                gap: 8px;
            }

            .admin-account-actions .admin-action-btn {
                min-width: 132px;
                padding: 8px 10px;
            }

            .admin-account-actions .admin-action-btn.ban {
                min-width: 128px;
            }
        }
    </style>
}

<div class="admin-users-wrap">
    <div class="admin-account-shell" id="adminAccountShell">
        <div class="admin-header-actions">
            <button type="button" class="admin-action-btn accept" onclick="saveAdminProfile()">Save Changes</button>
            <button type="button" class="admin-action-btn ban" onclick="cancelAdminEdit()">Cancel</button>
        </div>

        <div class="admin-account-top">
            <label class="admin-avatar-wrap" for="adminAvatarInput">
                <img id="adminAvatar" src="@Url.Content("~/Content/images/artzada_logo.png")" alt="Admin avatar" />
            </label>
            <input type="file" id="adminAvatarInput" accept="image/*" />

            <div>
                <div class="admin-account-title">Admin Account</div>
                <div class="admin-account-subtitle">Manage profile, password, and session settings</div>
                <div class="admin-username-display" id="adminUsernameDisplay">@adminUser</div>
                <div class="admin-inline-edit">
                    <input type="text" id="adminUsername" value="@adminUser" />
                </div>
            </div>
        </div>

        <div class="admin-pass-panel">
            <h3>Change Password</h3>
            <div class="admin-pass-grid">
                <div class="admin-pass-item">
                    <label for="adminCurrentPassword">Current password</label>
                    <div class="admin-pass-wrap">
                        <input id="adminCurrentPassword" type="password" />
                        <button type="button" onclick="toggleAdminPassword('adminCurrentPassword', this)">Show</button>
                    </div>
                </div>
                <div class="admin-pass-item">
                    <label for="adminNewPassword">New password</label>
                    <div class="admin-pass-wrap">
                        <input id="adminNewPassword" type="password" />
                        <button type="button" onclick="toggleAdminPassword('adminNewPassword', this)">Show</button>
                    </div>
                </div>
                <div class="admin-pass-item">
                    <label for="adminConfirmPassword">Confirm password</label>
                    <div class="admin-pass-wrap">
                        <input id="adminConfirmPassword" type="password" />
                        <button type="button" onclick="toggleAdminPassword('adminConfirmPassword', this)">Show</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-account-actions">
            <button type="button" class="admin-action-btn view" onclick="startAdminEdit('username')">Edit Username</button>
            <button type="button" class="admin-action-btn view" onclick="startAdminEdit('profile')">Change Profile</button>
            <button type="button" class="admin-action-btn view" onclick="startAdminEdit('password')">Change Password</button>
            <button type="button" class="admin-action-btn ban" onclick="adminSignOut()">Sign Out</button>
        </div>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            var profileKey = 'artzadaAdminProfile';
            var shell = document.getElementById('adminAccountShell');
            var usernameInput = document.getElementById('adminUsername');
            var usernameDisplay = document.getElementById('adminUsernameDisplay');
            var avatarInput = document.getElementById('adminAvatarInput');
            var avatarImg = document.getElementById('adminAvatar');
            var adminCurrentPassword = document.getElementById('adminCurrentPassword');
            var adminNewPassword = document.getElementById('adminNewPassword');
            var adminConfirmPassword = document.getElementById('adminConfirmPassword');

            var originalName = (usernameInput && usernameInput.value) || '@adminUser';
            var originalAvatar = avatarImg ? avatarImg.src : '';

            function readProfile() {
                return JSON.parse(localStorage.getItem(profileKey) || '{}');
            }

            function writeProfile(data) {
                localStorage.setItem(profileKey, JSON.stringify(data));
            }

            function loadProfile() {
                var profile = readProfile();
                if (profile.userName) {
                    usernameInput.value = profile.userName;
                    usernameDisplay.textContent = profile.userName;
                    originalName = profile.userName;
                }
                if (profile.avatar) {
                    avatarImg.src = profile.avatar;
                    originalAvatar = profile.avatar;
                }
            }

            function clearPasswordFields() {
                adminCurrentPassword.value = '';
                adminNewPassword.value = '';
                adminConfirmPassword.value = '';
            }

            function setEditState(isEditing, showPasswordPanel) {
                shell.classList.toggle('editing', !!isEditing);
                shell.classList.toggle('pass-edit', !!showPasswordPanel);
                if (!showPasswordPanel) {
                    clearPasswordFields();
                }
            }

            window.startAdminEdit = function (mode) {
                if (mode === 'profile') {
                    avatarInput.click();
                    setEditState(true, false);
                    return;
                }

                if (mode === 'password') {
                    setEditState(true, true);
                    return;
                }

                setEditState(true, false);
            };

            window.cancelAdminEdit = function () {
                usernameInput.value = originalName;
                usernameDisplay.textContent = originalName;
                avatarImg.src = originalAvatar;
                setEditState(false, false);
            };

            window.saveAdminProfile = function () {
                var profile = readProfile();
                var newName = (usernameInput.value || '').trim();
                if (!newName) {
                    if (window.themeToast) window.themeToast('Username cannot be empty.', 'warn');
                    return;
                }

                profile.userName = newName;
                profile.avatar = avatarImg.src;
                writeProfile(profile);
                originalName = newName;
                originalAvatar = avatarImg.src;
                usernameDisplay.textContent = newName;

                var shouldUpdatePassword = shell.classList.contains('pass-edit');
                if (shouldUpdatePassword) {
                    var currentPassword = adminCurrentPassword.value;
                    var newPassword = adminNewPassword.value;
                    var confirmPassword = adminConfirmPassword.value;

                    if (!currentPassword || !newPassword || !confirmPassword) {
                        if (window.themeToast) window.themeToast('Fill out all password fields.', 'warn');
                        return;
                    }

                    if (newPassword !== confirmPassword) {
                        if (window.themeToast) window.themeToast('New password and confirmation do not match.', 'warn');
                        return;
                    }
                }

                setEditState(false, false);
                if (window.themeToast) window.themeToast('Admin profile updated.', 'success');
            };

            avatarInput.addEventListener('change', function () {
                var file = avatarInput.files && avatarInput.files[0];
                if (!file) {
                    return;
                }

                var reader = new FileReader();
                reader.onload = function (event) {
                    avatarImg.src = event.target.result;
                    setEditState(true, false);
                };
                reader.readAsDataURL(file);
            });

            window.toggleAdminPassword = function (id, button) {
                var input = document.getElementById(id);
                if (!input) {
                    return;
                }

                var isVisible = input.type === 'text';
                input.type = isVisible ? 'password' : 'text';
                button.textContent = isVisible ? 'Show' : 'Hide';
            };

            window.adminSignOut = function () {
                if (window.themeConfirm) {
                    window.themeConfirm('Sign out from admin account?', function () {
                        window.location.href = '@Url.Action("Logout", "Admin")';
                    });
                }
            };

            setEditState(false, false);
            loadProfile();
        })();
    </script>
}
