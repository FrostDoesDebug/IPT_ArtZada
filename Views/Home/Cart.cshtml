@{
    ViewBag.Title = "Cart";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet" />
    <style>
        @@font-face {
            font-family: 'RushonGround';
            src: url('/Content/Font/Rushon Ground.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #EDDCC6;
            background-image: url('/Content/images/paperbg.png');
            background-repeat: no-repeat;
            background-position: center center;
            background-attachment: fixed;
            background-size: cover;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ── NAVBAR ── */
        .navbar-container {
            background: #BF4646;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 50px;
            position: relative;
            z-index: 10;
        }

        .nav-logo {
            position: absolute;
            left: 20px;
            display: flex;
            align-items: center;
        }

            .nav-logo svg {
                width: 44px;
                height: 28px;
            }

        .navbar {
            display: flex;
            gap: 60px;
        }

            .navbar a {
                color: rgba(0,0,0,0.75);
                font-family: 'Poppins', sans-serif;
                font-weight: 700;
                text-decoration: none;
                font-size: 14px;
                letter-spacing: 0.5px;
                transition: color 0.2s;
            }

                .navbar a:hover {
                    color: rgba(0,0,0,0.95);
                }

                .navbar a.active {
                    color: #fff;
                }

        .nav-bell {
            position: absolute;
            right: 0;
            top: 0;
            width: 80px;
            height: 78px;
            background: #BF4646;
            border-bottom-left-radius: 18px;
            border-bottom-right-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: filter 0.15s;
            z-index: 20;
        }

            .nav-bell:hover {
                filter: brightness(1.15);
            }

            .nav-bell img {
                width: 46px;
                height: 46px;
                object-fit: contain;
                margin-top: 20px;
            }

        /* ── PAGE CONTENT ── */
        .page-content {
            flex: 1;
            padding: 24px 36px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
        }

        /* ── TAB BUTTONS ── */
        .tab-buttons {
            display: flex;
            gap: 14px;
            width: 88%;
        }

        .tab-btn {
            width: 100px;
            height: 100px;
            border-radius: 18px;
            border: 5px solid #1a1a1a;
            background: #8C571C;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s, background 0.15s;
            padding: 0;
            overflow: hidden;
        }

            .tab-btn img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                filter: brightness(0) invert(1);
            }

            .tab-btn:hover {
                filter: brightness(1.15);
                transform: translateY(-2px);
            }

            .tab-btn:active {
                transform: translateY(0);
            }

            .tab-btn.active {
                background: #D88628;
                border-color: #1a1a1a;
            }

        /* ── MAIN PANEL ── */
        .main-panel {
            background: #276470;
            border-radius: 18px;
            border: 5px solid #1a1a1a;
            padding: 18px;
            width: 88%;
            min-height: 420px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* ── INNER HEADER ROW ── */
        .panel-header {
            background: #7EACB5;
            border-radius: 12px;
            border: 4px solid #1a1a1a;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            min-height: 80px;
        }

        /* ── ORDER RECIEVED BUTTON ── */
        .btn-order-recieved {
            background: #BF4646;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1rem;
            padding: 10px 20px;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            white-space: nowrap;
            display: none;
        }

            .btn-order-recieved:hover {
                filter: brightness(1.1);
                transform: translateY(-2px);
            }

            .btn-order-recieved:active {
                transform: translateY(0);
                filter: brightness(0.9);
            }

        /* ── PANEL BODY ── */
        .panel-body {
            flex: 1;
            min-height: 280px;
        }

        /* ── TAB PANELS ── */
        .tab-panel {
            display: none;
        }

            .tab-panel.active {
                display: flex;
                flex-direction: column;
                gap: 12px;
                width: 100%;
                height: 100%;
            }

        @@media (max-width: 900px) {
            .main-panel,
            .tab-buttons {
                width: 100%;
            }

            .tab-btn {
                width: 70px;
                height: 70px;
            }

            .navbar {
                gap: 20px;
            }
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white"></polygon>
                <polygon points="26,4  42,14  26,24" fill="white"></polygon>
            </svg>
        </div>
        <nav class="navbar">
            <a href="@Url.Action("BuyerSideHome","Home")">Home</a>
            <a href="@Url.Action("BuyerSideShop","Home")">Shop</a>
            <a href="@Url.Action("BuyerSideMessage","Home")">Message</a>
            <a href="@Url.Action("BuyerSideCart","Home")" class="active">Cart</a>
            <a href="@Url.Action("BuyerSideAccount","Home")">Account</a>
        </nav>
        <div class="nav-bell" onclick="window.location.href='@Url.Action("Notifications","Home")'">
            <img src="@Url.Content("~/Content/images/notification.png")" alt="Notifications" />
        </div>
    </div>

    <!-- PAGE CONTENT -->
    <div class="page-content">

        <!-- TAB BUTTONS: to_pay → to_ship → to_recieve -->
        <div class="tab-buttons">
            <div class="tab-btn active" id="btn-to_pay" onclick="switchTab('to_pay')" title="To Pay">
                <img src="@Url.Content("~/Content/images/to_pay.png")" alt="To Pay" />
            </div>
            <div class="tab-btn" id="btn-to_ship" onclick="switchTab('to_ship')" title="To Ship">
                <img src="@Url.Content("~/Content/images/to_ship.png")" alt="To Ship" />
            </div>
            <div class="tab-btn" id="btn-to_recieve" onclick="switchTab('to_recieve')" title="To Recieve">
                <img src="@Url.Content("~/Content/images/to_receive.png")" alt="To Recieve" />
            </div>
        </div>

        <!-- MAIN PANEL -->
        <div class="main-panel">

            <!-- HEADER ROW -->
            <div class="panel-header" id="panel-header">
                <button class="btn-order-recieved" id="btn-order-recieved" onclick="markOrderRecieved()">
                    Order Recieved
                </button>
            </div>

            <!-- PANEL BODY -->
            <div class="panel-body">

                <!-- TO PAY PANEL -->
                <div class="tab-panel active" id="panel-to_pay">
                    <!-- Items waiting for payment listed here -->
                </div>

                <!-- TO SHIP PANEL -->
                <div class="tab-panel" id="panel-to_ship">
                    <!-- Items to ship listed here -->
                </div>

                <!-- TO RECIEVE PANEL -->
                <div class="tab-panel" id="panel-to_recieve">
                    <!-- Items to recieve listed here -->
                </div>

            </div>
        </div>
    </div>

    <script>
        var currentTab = 'to_pay';

        function switchTab(tab) {
            // Remove active from all buttons using underscore IDs
            document.getElementById('btn-to_pay').classList.remove('active');
            document.getElementById('btn-to_ship').classList.remove('active');
            document.getElementById('btn-to_recieve').classList.remove('active');

            // Hide all panels
            document.querySelectorAll('.tab-panel').forEach(function (p) {
                p.classList.remove('active');
            });

            // Activate selected tab and panel
            currentTab = tab;
            document.getElementById('panel-' + tab).classList.add('active');
            document.getElementById('btn-' + tab).classList.add('active');

            // Show Order Recieved button only on to_recieve tab
            var orderBtn = document.getElementById('btn-order-recieved');
            orderBtn.style.display = (tab === 'to_recieve') ? 'inline-block' : 'none';
        }

        function markOrderRecieved() {
            alert('Order marked as recieved!');
        }
    </script>

</body>
</html>

