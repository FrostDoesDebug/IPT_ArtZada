@{
    ViewBag.Title = "SellerProf";
    Layout = null;
}

<link rel="stylesheet" href="~/Content/Site.css" />

<div class="page-container">

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="nav-arrows">
            <button class="nav-btn">&#9664;</button>
            <button class="nav-btn">&#9654;</button>
        </div>

        <div class="navbar">
            <a href="/Home/Index"
               class="@(currentAction == "Index" ? "active" : "")">Home</a>

            <a href="#">Shop</a>

            <a href="/Home/Message"
               class="@(currentAction == "Message" ? "active" : "")">Message</a>

            <a href="/Home/Cart"
               class="@(currentAction == "Cart" ? "active" : "")">Cart</a>

            <a href="/Home/Account"
               class="@(currentAction == "Account" ? "active" : "")">Account</a>
        </div>
    </div>

    <!-- PROFILE HEADER -->
    <div class="profile-header">
        <div class="profile-pic">
            <img src="@Url.Content("~/images/profile.jpg")" alt="profile" />
        </div>

        <div class="profile-info">
            <h1>KWEKKWEKSASTIX</h1>

            <button class="message-btn">
                ✉ Send Message!
            </button>
        </div>
    </div>

    <!-- ARTWORK SECTION -->
    <div class="artworks-section">
        <h2>ARTWORKS</h2>

        <div class="art-grid">

            <div class="art-card">
                <img src="@Url.Content("~/images/dog.jpg")" alt="art" />
                <h3>CHUBB</h3>
                <p>Digital Print</p>
                <span class="price">₱100.00</span>
            </div>

            <div class="art-card empty"></div>
            <div class="art-card empty"></div>
            <div class="art-card empty"></div>

        </div>
    </div>

</div>