@{
    ViewBag.Title = "Edit Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Password – Admin Panel</title>
    <link href="@Url.Content("~/Content/CSS/AdminEditAccount.css")" rel="stylesheet" />
</head>
<body>

    <div class="page-content">

        <div class="btn-back" onclick="window.location.href='@Url.Action("AdminAccount","Home")'">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32">
                <polyline points="15,6 9,12 15,18" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
            </svg>
        </div>

        <div class="edit-card">

            <div class="edit-title">Edit</div>

            <div class="edit-form">

                <div class="field-group">
                    <label for="oldPassword">Old Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="oldPassword" autocomplete="current-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('oldPassword', this)" aria-label="Toggle password visibility">
                            <!-- EYE OPEN icon -->
                            <svg id="oldPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <!-- EYE CLOSED icon -->
                            <svg id="oldPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errOld">Please enter your old password.</span>
                </div>

                <div class="field-group">
                    <label for="newPassword">New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="newPassword" autocomplete="new-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('newPassword', this)" aria-label="Toggle password visibility">
                            <svg id="newPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="newPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errNew">Password must be at least 6 characters.</span>
                </div>

                <div class="field-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" autocomplete="new-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('confirmPassword', this)" aria-label="Toggle password visibility">
                            <svg id="confirmPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="confirmPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errConfirm">Passwords do not match.</span>
                </div>

            </div>

            <button class="btn-confirm" onclick="submitForm()">Confirm!</button>
            <button class="btn-cancel" onclick="window.location.href='@Url.Action("AdminAccount","Home")'">Cancel</button>

        </div>

    </div>

    <div class="toast" id="toast">Password changed successfully!</div>

    <script>
        var STORAGE_KEY_PASSWORD = 'adminPassword';

        function togglePassword(fieldId, btn) {
            var input     = document.getElementById(fieldId);
            var eyeOpen   = document.getElementById(fieldId + '-eye-open');
            var eyeClosed = document.getElementById(fieldId + '-eye-closed');

            if (input.type === 'password') {
                input.type        = 'text';
                eyeOpen.style.display   = 'none';
                eyeClosed.style.display = 'block';
            } else {
                input.type        = 'password';
                eyeOpen.style.display   = 'block';
                eyeClosed.style.display = 'none';
            }
        }

        function clearErrors() {
            document.querySelectorAll('.error-msg').forEach(function (e) {
                e.classList.remove('visible');
            });
        }

        function submitForm() {
            clearErrors();

            var oldPw  = document.getElementById('oldPassword').value;
            var newPw  = document.getElementById('newPassword').value.trim();
            var confPw = document.getElementById('confirmPassword').value.trim();
            var valid  = true;

            if (!oldPw) {
                document.getElementById('errOld').classList.add('visible');
                valid = false;
            }

            if (newPw.length < 6) {
                document.getElementById('errNew').classList.add('visible');
                valid = false;
            }

            if (newPw !== confPw) {
                document.getElementById('errConfirm').classList.add('visible');
                valid = false;
            }

            if (!valid) return;

            localStorage.setItem(STORAGE_KEY_PASSWORD, newPw);

            showToast();
            setTimeout(function () {
                window.location.href = '@Url.Action("AdminAccount","Home")';
            }, 2600);
        }

        function showToast() {
            var t = document.getElementById('toast');
            t.classList.remove('visible');
            void t.offsetWidth;
            t.classList.add('visible');
        }
    </script>

</body>
</html>