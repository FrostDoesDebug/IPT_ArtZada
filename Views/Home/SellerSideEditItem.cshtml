@{
    ViewBag.Title = "EditItem";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Item - Seller</title>
    <link href="@Url.Content("~/Content/CSS/SellerSideEditItem.css")" rel="stylesheet" />
</head>
<body>
    <div class="navbar-container">
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white"></polygon>
                <polygon points="26,4  42,14  26,24" fill="white"></polygon>
            </svg>
        </div>
        <nav class="navbar">
            <a href="@Url.Action("SellerSideStore","Home")" class="active">Store</a>
            <a href="@Url.Action("SellerSideMessage","Home")">Message</a>
            <a href="@Url.Action("SellerSideAnalytics","Home")">Analytics</a>
            <a href="@Url.Action("SellerSideAccount","Home")">Account</a>
        </nav>
        <div class="nav-bell" onclick="window.location.href='@Url.Action("Notifications","Home")'">
            <img src="@Url.Content("~/Content/images/notification.png")" alt="Notifications" />
        </div>
    </div>

    <div class="page-content">
        <div class="title-wrap">
            <div class="page-title">Edit Item</div>
        </div>
        <div class="form-panel">
            <div class="photo-col">
                <div class="photo-box">
                    <img id="photoPreview" src="@Url.Content("~/Content/images/artzada_logo.png")" alt="Item Photo" />
                </div>
                <button class="btn-add-photo" type="button" onclick="document.getElementById('photoInput').click()">
                    Change Photo
                </button>
                <button class="btn-cancel-left" type="button" onclick="window.location.href='@Url.Action("SellerSideStore","Home")'">
                    Cancel
                </button>
                <input type="file" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(event)" />
            </div>
            <div class="fields-col">
                <div class="fields-row">
                    <div class="fields-inner">
                        <div class="field-group">
                            <label class="field-label">Name</label>
                            <input type="text" class="field-input" id="itemName" />
                        </div>
                        <div class="type-row">
                            <label class="field-label">Type</label>
                            <div class="type-select-wrap">
                                <select id="itemType">
                                    <option value=""></option>
                                    <option value="Digital Print">Digital Print</option>
                                    <option value="Sticker">Sticker</option>
                                    <option value="Poster">Poster</option>
                                    <option value="Canvas">Canvas</option>
                                    <option value="Commission">Commission</option>
                                </select>
                                <div class="dropdown-arrow">
                                    <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"></path></svg>
                                </div>
                            </div>
                        </div>
                        <div class="price-stock-row">
                            <div class="field-group">
                                <label class="field-label">Price</label>
                                <input type="number" class="field-input regular-font" id="itemPrice" placeholder="0.00" min="0" step="0.01" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Stocks</label>
                                <input type="number" class="field-input regular-font" id="itemStocks" placeholder="0" min="0" />
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Description</label>
                            <textarea class="field-textarea" id="itemDescription"></textarea>
                        </div>
                    </div>
                    <div class="right-actions">
                        <button class="btn-submit" type="button" onclick="saveChanges()">Save Changes</button>
                        <button class="btn-cancel-right" type="button" onclick="window.location.href='@Url.Action("SellerSideStore","Home")'">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var currentPhotoData = '';
        var editId = localStorage.getItem('editItemId');

        function loadItemForEdit() {
            if (!editId) { window.location.href = '@Url.Action("SellerSideStore","Home")'; return; }
            var items = JSON.parse(localStorage.getItem('sellerItems') || '[]');
            var item = null;
            for (var i = 0; i < items.length; i++) {
                if (items[i].id === editId) { item = items[i]; break; }
            }
            if (!item) { window.location.href = '@Url.Action("SellerSideStore","Home")'; return; }

            document.getElementById('itemName').value = item.name;
            document.getElementById('itemType').value = item.type;
            document.getElementById('itemPrice').value = item.price;
            document.getElementById('itemStocks').value = item.stocks;
            document.getElementById('itemDescription').value = item.description || '';
            document.getElementById('photoPreview').src = item.photo;
            currentPhotoData = item.photo;
        }

        function previewPhoto(event) {
            var file = event.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (e) {
                currentPhotoData = e.target.result;
                document.getElementById('photoPreview').src = currentPhotoData;
            };
            reader.readAsDataURL(file);
        }

        function saveChanges() {
            var name   = document.getElementById('itemName').value.trim();
            var type   = document.getElementById('itemType').value;
            var price  = document.getElementById('itemPrice').value;
            var stocks = document.getElementById('itemStocks').value;
            var desc   = document.getElementById('itemDescription').value.trim();

            if (!name)   { alert('Please enter a name.');         return; }
            if (!type)   { alert('Please select a type.');        return; }
            if (!price)  { alert('Please enter a price.');        return; }
            if (!stocks) { alert('Please enter a stock amount.'); return; }

            var items = JSON.parse(localStorage.getItem('sellerItems') || '[]');
            for (var i = 0; i < items.length; i++) {
                if (items[i].id === editId) {
                    items[i].name        = name;
                    items[i].type        = type;
                    items[i].price       = price;
                    items[i].stocks      = stocks;
                    items[i].description = desc;
                    items[i].photo       = currentPhotoData;
                    break;
                }
            }
            localStorage.setItem('sellerItems', JSON.stringify(items));
            localStorage.removeItem('editItemId');
            window.location.href = '@Url.Action("SellerSideStore","Home")';
        }

        loadItemForEdit();
    </script>
</body>
</html>