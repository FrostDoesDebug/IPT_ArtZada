
@{
    ViewBag.Title = "BuyerMessage";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Messages</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/Site.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/CSS/BuyerMessage.css")" />

    <style>
        
        .navbar-container {
            top: 0; 
        }

        body {
            padding-top: 50px; 
        }
    </style>
</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="nav-arrows">
            <button class="nav-btn">&#9664;</button>
            <button class="nav-btn">&#9654;</button>
        </div>

        <div class="navbar">
            <a href="/Home/Index"
               class="@(currentAction == "Index" ? "active" : "")">Home</a>

            <a href="/Home/Index"
               class="@(currentAction == "Shop" ? "active" : "")">Shop</a>

            <a href="/Home/Message"
               class="@(currentAction == "Message" ? "active" : "")">Message</a>

            <a href="/Home/Cart"
               class="@(currentAction == "Cart" ? "active" : "")">Cart</a>

            <a href="/Home/Account"
               class="@(currentAction == "Account" ? "active" : "")">Account</a>
        </div>
    </div>

    <!-- MESSAGE LAYOUT -->
    <div style="display: flex; gap: 20px; margin: 20px">
        <!-- LEFT PANEL -->
        <div style="
          width: 300px;
          background: #7ea4a8;
          border: 5px solid black;
          border-radius: 15px;
          padding: 10px;
        ">
            <div style="
            background: #bf4646;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 10px;
          ">
                <strong>KWEKKWEKSASTIX</strong>
            </div>

            <div style="
            height: 100px;
            border: 3px solid black;
            border-radius: 10px;
            margin-bottom: 10px;
          "></div>
            <div style="
            height: 100px;
            border: 3px solid black;
            border-radius: 10px;
            margin-bottom: 10px;
          "></div>
        </div>

        <!-- CHAT PANEL -->
        <div style="
          flex: 1;
          background: #7ea4a8;
          border: 5px solid black;
          border-radius: 15px;
          padding: 20px;
          display: flex;
          flex-direction: column;
        ">
            <!-- HEADER -->
            <div style="
            background: #bf4646;
            padding: 10px;
            border-radius: 10px;
            margin-bottom: 20px;
          ">
                <strong>KWEKKWEKSASTIX</strong>
            </div>

            <!-- CHAT -->
            <div style="flex: 1">
                <p><strong>April 9</strong></p>

                <div style="
              background: #276470;
              padding: 10px 15px;
              border-radius: 20px;
              width: max-content;
              margin-bottom: 10px;
            ">
                    Kwekkwek ka ba?
                </div>

                <div style="
              background: #276470;
              padding: 10px 15px;
              border-radius: 20px;
              width: max-content;
              margin-left: auto;
              margin-bottom: 10px;
            ">
                    Bakit?
                </div>

                <div style="
              background: #276470;
              padding: 10px 15px;
              border-radius: 20px;
              width: max-content;
              margin-bottom: 10px;
            ">
                    Sarap mo kasi tusukin
                </div>

                <div style="
              background: #276470;
              padding: 10px 15px;
              border-radius: 20px;
              width: max-content;
              margin-left: auto;
            ">
                    haha
                </div>
            </div>

            <!-- INPUT -->
            <div style="display: flex; gap: 10px; margin-top: 20px">
                <input type="text"
                       placeholder="Ayos"
                       style="
              flex: 1;
              padding: 10px;
              border-radius: 10px;
              border: 3px solid black;
            " />

                <button style="
              padding: 10px 15px;
              border-radius: 10px;
              border: 3px solid black;
            ">
                    Send
                </button>
            </div>
        </div>
    </div>
    <script src="~/Scripts/site.js"></script>
</body>
</html>
