@{
    ViewBag.Title = "Edit Password";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit Password – Admin Panel</title>
    <link href="@Url.Content("~/Content/CSS/AdminEditAccount.css")" rel="stylesheet" />
    <style>
        @@font-face {
            font-family: 'RushonGround';
            src: url('@Url.Content("~/Content/Font/Rushon Ground.ttf")') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Poppins', sans-serif;
            background: #f4f4f4 url('@Url.Content("~/Content/images/paperbg.png")') no-repeat center center fixed;
            background-size: cover;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .page-content {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 30px 60px;
            position: relative;
        }

        .btn-back {
            position: absolute;
            top: 20px;
            left: 40px;
            width: 72px;
            height: 72px;
            background-color: #BF4646;
            border: 4px solid #1a1a1a;
            border-radius: 14px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: filter 0.15s, transform 0.1s;
        }

        .btn-back:hover  { filter: brightness(1.15); transform: translateY(-2px); }
        .btn-back:active { transform: translateY(0);  filter: brightness(0.9); }

        .edit-card {
            background-color: #7EACB5;
            border: 5px solid #1a1a1a;
            border-radius: 22px;
            padding: 36px 60px;
            width: 100%;
            max-width: 480px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 22px;
            box-shadow: 0 8px 32px rgba(0,0,0,0.35);
        }

        .edit-title {
            font-family: 'RushonGround', cursive;
            font-size: 5rem;
            color: #ffffff;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            line-height: 1;
            -webkit-text-stroke: 4px #1a1a1a;
            paint-order: stroke fill;
            text-shadow:
                -3px -3px 0 #1a1a1a,  3px -3px 0 #1a1a1a,
                -3px  3px 0 #1a1a1a,  3px  3px 0 #1a1a1a,
                 0px -3px 0 #1a1a1a,  0px  3px 0 #1a1a1a,
                -3px  0px 0 #1a1a1a,  3px  0px 0 #1a1a1a;
        }

        .edit-form { width: 100%; display: flex; flex-direction: column; gap: 14px; }

        .field-group { display: flex; flex-direction: column; gap: 4px; }

        .field-group label {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            color: #ffffff;
            letter-spacing: 0.01em;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

        .input-wrapper input {
            width: 100%;
            padding: 8px 44px 8px 14px;
            border: none;
            border-radius: 6px;
            font-family: 'Poppins', sans-serif;
            font-size: 0.95rem;
            background: #ffffff;
            color: #1a1a1a;
            outline: none;
            transition: box-shadow 0.2s;
            height: 36px;
        }

        .input-wrapper input:focus { box-shadow: 0 0 0 3px rgba(26,58,64,0.35); }

        .toggle-eye {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            cursor: pointer;
            padding: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #276470;
            transition: color 0.15s;
        }

        .toggle-eye:hover { color: #1a3a40; }

        .toggle-eye svg {
            width: 20px;
            height: 20px;
            pointer-events: none;
        }

        .error-msg {
            display: none;
            font-size: 0.78rem;
            color: #3a0000;
            font-weight: 700;
            margin-top: 2px;
        }

        .error-msg.visible { display: block; }

        .btn-confirm {
            width: 100%;
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1.2rem;
            color: #1a1a1a;
            background-color: #5DDB44;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            padding: 14px 0;
            cursor: pointer;
            letter-spacing: 0.04em;
            transition: filter 0.15s, transform 0.1s;
            margin-top: 6px;
        }

        .btn-confirm:hover  { filter: brightness(1.1); transform: translateY(-2px); }
        .btn-confirm:active { transform: translateY(0); filter: brightness(0.92); }

        .btn-cancel {
            width: 55%;
            font-family: 'Poppins', sans-serif;
            font-weight: 800;
            font-size: 1rem;
            color: #ffffff;
            background-color: #BF4646;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            padding: 10px 0;
            cursor: pointer;
            letter-spacing: 0.04em;
            transition: filter 0.15s, transform 0.1s;
        }

        .btn-cancel:hover  { filter: brightness(1.1); transform: translateY(-2px); }
        .btn-cancel:active { transform: translateY(0); filter: brightness(0.92); }

        .toast {
            display: none;
            position: fixed;
            bottom: 36px;
            left: 50%;
            transform: translateX(-50%);
            background: #1a3a40;
            color: white;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 14px 32px;
            border-radius: 50px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            z-index: 9999;
            letter-spacing: 0.02em;
        }

        .toast.visible {
            display: block;
            animation: fadeInOut 2.5s forwards;
        }

        @@keyframes fadeInOut {
            0%   { opacity: 0; transform: translateX(-50%) translateY(10px); }
            15%  { opacity: 1; transform: translateX(-50%) translateY(0); }
            75%  { opacity: 1; }
            100% { opacity: 0; }
        }

        @@media (max-width: 768px) {
            .page-content { padding: 24px 16px; }
            .edit-card { padding: 30px 28px; max-width: 100%; }
            .edit-title { font-size: 3rem; }
            .btn-back { width: 54px; height: 54px; top: 16px; left: 16px; }
            .btn-cancel { width: 70%; }
        }
    </style>
</head>
<body>

    <div class="page-content">

        <div class="btn-back" onclick="window.location.href='@Url.Action("AdminAccount","Home")'">
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" width="32" height="32">
                <polyline points="15,6 9,12 15,18" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></polyline>
            </svg>
        </div>

        <div class="edit-card">

            <div class="edit-title">Edit</div>

            <div class="edit-form">

                <div class="field-group">
                    <label for="oldPassword">Old Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="oldPassword" autocomplete="current-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('oldPassword', this)" aria-label="Toggle password visibility">
                            <!-- EYE OPEN icon -->
                            <svg id="oldPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <!-- EYE CLOSED icon -->
                            <svg id="oldPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errOld">Please enter your old password.</span>
                </div>

                <div class="field-group">
                    <label for="newPassword">New Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="newPassword" autocomplete="new-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('newPassword', this)" aria-label="Toggle password visibility">
                            <svg id="newPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="newPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errNew">Password must be at least 6 characters.</span>
                </div>

                <div class="field-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="confirmPassword" autocomplete="new-password" />
                        <button type="button" class="toggle-eye" onclick="togglePassword('confirmPassword', this)" aria-label="Toggle password visibility">
                            <svg id="confirmPassword-eye-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:block;">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            <svg id="confirmPassword-eye-closed" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"></path>
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
                                <line x1="1" y1="1" x2="23" y2="23"></line>
                            </svg>
                        </button>
                    </div>
                    <span class="error-msg" id="errConfirm">Passwords do not match.</span>
                </div>

            </div>

            <button class="btn-confirm" onclick="submitForm()">Confirm!</button>
            <button class="btn-cancel" onclick="window.location.href='@Url.Action("AdminAccount","Home")'">Cancel</button>

        </div>

    </div>

    <div class="toast" id="toast">Password changed successfully!</div>

    <script>
        var STORAGE_KEY_PASSWORD = 'adminPassword';

        function togglePassword(fieldId, btn) {
            var input     = document.getElementById(fieldId);
            var eyeOpen   = document.getElementById(fieldId + '-eye-open');
            var eyeClosed = document.getElementById(fieldId + '-eye-closed');

            if (input.type === 'password') {
                input.type        = 'text';
                eyeOpen.style.display   = 'none';
                eyeClosed.style.display = 'block';
            } else {
                input.type        = 'password';
                eyeOpen.style.display   = 'block';
                eyeClosed.style.display = 'none';
            }
        }

        function clearErrors() {
            document.querySelectorAll('.error-msg').forEach(function (e) {
                e.classList.remove('visible');
            });
        }

        function submitForm() {
            clearErrors();

            var oldPw  = document.getElementById('oldPassword').value;
            var newPw  = document.getElementById('newPassword').value.trim();
            var confPw = document.getElementById('confirmPassword').value.trim();
            var valid  = true;

            if (!oldPw) {
                document.getElementById('errOld').classList.add('visible');
                valid = false;
            }

            if (newPw.length < 6) {
                document.getElementById('errNew').classList.add('visible');
                valid = false;
            }

            if (newPw !== confPw) {
                document.getElementById('errConfirm').classList.add('visible');
                valid = false;
            }

            if (!valid) return;

            localStorage.setItem(STORAGE_KEY_PASSWORD, newPw);

            showToast();
            setTimeout(function () {
                window.location.href = '@Url.Action("AdminAccount","Home")';
            }, 2600);
        }

        function showToast() {
            var t = document.getElementById('toast');
            t.classList.remove('visible');
            void t.offsetWidth;
            t.classList.add('visible');
        }
    </script>

</body>
</html>