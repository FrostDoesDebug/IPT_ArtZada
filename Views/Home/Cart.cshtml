@{
    ViewBag.Title = "Cart";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet" />
    <link href="~/Content/CSS/Cart.css" rel="stylesheet" />
</head>

<body>

    <!-- NAVBAR -->
    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <div class="navbar-container">
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white"></polygon>
                <polygon points="26,4  42,14  26,24" fill="white"></polygon>
            </svg>
        </div>

        <div class="navbar">
            <a href="/Home/Index" class="@(currentAction == "Index" ? "active" : "")">Home</a>
            <a href="#">Shop</a>
            <a href="/Home/Message" class="@(currentAction == "Message" ? "active" : "")">Message</a>
            <a href="/Home/Cart" class="@(currentAction == "Cart" ? "active" : "")">Cart</a>
            <a href="/Home/Account" class="@(currentAction == "Account" ? "active" : "")">Account</a>
        </div>
    </div>

    <!-- CART -->
    <div class="cart-wrapper">
        <h1 class="cart-title">ART BY KWEKKWEKSASTIX</h1>

        <div class="cart-item">
            <input type="checkbox" class="cart-checkbox" />
            <img src="~/images/sample-art.png" class="cart-img" />

            <!-- HEADER ROW -->
            <div class="panel-header" id="panel-header">
                <button class="btn-order-recieved" id="btn-order-recieved" onclick="markOrderRecieved()">
                    Order Recieved
                </button>
            </div>

            <!-- PANEL BODY -->
            <div class="panel-body">

                <!-- TO PAY PANEL -->
                <div class="tab-panel active" id="panel-to_pay">
                    <!-- Items waiting for payment listed here -->
                </div>

                <!-- TO SHIP PANEL -->
                <div class="tab-panel" id="panel-to_ship">
                    <!-- Items to ship listed here -->
                </div>

                <!-- TO RECIEVE PANEL -->
                <div class="tab-panel" id="panel-to_recieve">
                    <!-- Items to recieve listed here -->
                </div>

            </div>
        </div>
    </div>

    <!-- OVERLAY -->
    <div id="overlay" class="overlay"></div>

    <!-- CHECKOUT BAR -->
    <div class="checkout-bar" id="checkoutBar">

        <!-- COLLAPSED -->
        <div class="checkout-inner">
            <h2>Total <span>₱100.00</span></h2>
            <button class="checkout-btn" onclick="openCheckout()">Check out</button>
        </div>

        <!-- EXPANDED -->
        <div class="checkout-expanded">

            <div class="form-row">
                <label>Full Name:</label>
                <input type="text">
            </div>

            <div class="form-row">
                <label>Address:</label>
                <input type="text">
            </div>

            <div class="form-row">
                <label>Payment:</label>
                <select>
                    <option>Cash on Delivery</option>
                    <option>GCash</option>
                </select>
            </div>

            <div class="checkout-bottom">
                <h3>Total: <span>₱999</span></h3>
                <button class="place-order-btn">Place Order</button>
            </div>

        </div>
    </div>

    <!-- SCRIPT -->
    <script>
        function openCheckout() {
            document.getElementById("checkoutBar").classList.add("expanded");
            document.getElementById("overlay").classList.add("active");
        }

        function closeCheckout() {
            document.getElementById("checkoutBar").classList.remove("expanded");
            document.getElementById("overlay").classList.remove("active");
        }

        // CLICK OUTSIDE = CLOSE
        document.addEventListener("click", function (e) {
            var checkout = document.getElementById("checkoutBar");

            if (checkout.classList.contains("expanded")) {
                if (!checkout.contains(e.target)) {
                    closeCheckout();
                }
            }
        });

        // PREVENT CLOSE WHEN CLICKING INSIDE
        document.getElementById("checkoutBar").addEventListener("click", function (e) {
            e.stopPropagation();
        });

        // OVERLAY CLICK
        document.getElementById("overlay").addEventListener("click", function () {
            closeCheckout();
        });
    </script>

</body>
</html>
