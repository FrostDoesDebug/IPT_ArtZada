﻿@{
    ViewBag.Title = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Artzada</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/Content/CSS/Index.css" />
</head>

<body>
    @Html.AntiForgeryToken()
    <!-- TOP BAR -->
    <div class="top-bar">
        <div class="header">
            <div class="logo">
                <a href="/"><img src="~/Content/images/artzada_logo.png" alt="Artzada Logo" /></a>
            </div>

            <div class="search-panel">
                <div class="search-container">
                    <input type="text" placeholder="Search in Artzada" />
                    <button class="search-btn">
                        <img src="~/Content/images/search.png" alt="Search" />
                    </button>
                </div>

                <div class="filter">
                    <button class="dropdown-header">Filter</button>
                    <div class="dropdown-overlay">
                        <div class="dropdown-panel">
                            <button class="close-btn">&times;</button>
                            <div class="dropdown-section">
                                <h4 class="section-title">Prices</h4>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Below 100</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Above 100</label>
                            </div>

                            <div class="dropdown-section">
                                <h4 class="section-title">Medium</h4>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Digital Art</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Charcoal</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Colored Pencil</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Graphite</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Pastel</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Ink</label>
                                <label class="custom-checkbox"><input type="checkbox" /><span class="checkmark"></span>Others</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="icons">
                <a href="@Url.Action("Cart", "Client")" class="icon cart-icon">
                    <img src="~/Content/images/cart.png" alt="Cart" />
                    <span class="badge" id="cartBadge">0</span>
                </a>

                <a href="@Url.Action("Notifications", "Client")" class="icon">
                    <img src="~/Content/images/notification.png" alt="Notifications" />
                </a>
            </div>
        </div>

        <!-- NAVBAR -->
        @{
            var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        }
        <div class="navbar-container">
            <div class="nav-arrows">
                <button class="nav-btn">&#9664;</button>
                <button class="nav-btn">&#9654;</button>
            </div>

            <div class="navbar">
                <a href="/Client/Index" class="@(currentAction == "Index" ? "active" : "")">Home</a>
                <a href="#hotSales">Shop</a>
                <a href="/Client/Message" class="@(currentAction == "Message" ? "active" : "")">Message</a>
                <a href="/Client/Cart" class="@(currentAction == "Cart" ? "active" : "")">Cart</a>
                <a href="/Client/Account" class="@(currentAction == "Account" ? "active" : "")">Account</a>
            </div>
        </div>
    </div>

    <br /><br /><br /><br />

    <!-- FEATURED ARTISTS -->
    <h2 class="section-title">FEATURED ARTISTS</h2>
    <div class="carousel">
        <div class="carousel-track" id="carouselTrack">
            @for (int i = 0; i < 5; i++)
            {
                <div class="carousel-item">
                    <img src="~/Content/images/KwekKweksaStix (1).png" alt="Artist @i" class="artist-img" />
                    <div class="artist-info">
                        <h1>KwekKwekSaStix</h1>
                        <p>Digital Artist - Illustrator - Concept Artist</p>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- HOT SALES -->
    <h2 class="section-title" id="hotSales">HOT SALES</h2>
    <div class="grid" id="hotSalesGrid"></div>

    <!-- FLASH SALES -->
    <h2 class="section-title">FLASH SALES</h2>
    <div class="grid" id="flashSalesGrid"></div>

    <!-- SERVICES -->
    <h2 class="section-title">SERVICES</h2>
    <div class="grid">
        @for (int i = 0; i < 3; i++)
        {
            <div class="card large clickable-card" data-url="@Url.Action("Product", "Client", new { id = i + 20 })">
                <h2>Service @i</h2>
                <p>Our Service</p>
            </div>
        }
    </div>

    <!-- FOOTER -->
    <div class="footer">
        <div class="footer-left">
            <img src="~/Content/images/artzada_logo.png" alt="Artzada Logo" class="footer-logo" />
        </div>

        <div class="footer-right">
            <h3>ABOUT US</h3>
            <p>
                Artzada was founded with a simple idea: give artists a space where their creativity can be valued and discovered.
                Today, Artzada bridges imagination and opportunity.
            </p>

            <h3>CONTACT US: 0983-2134-231</h3>
        </div>
    </div>

    <!-- Javascript -->
    <script src="~/Scripts/site.js"></script>
    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const hotSalesGrid = document.getElementById('hotSalesGrid');
        const flashSalesGrid = document.getElementById('flashSalesGrid');

        function addToCart(productId, goCart) {
            var form = new URLSearchParams();
            form.append('__RequestVerificationToken', token);
            form.append('productId', productId);
            form.append('quantity', 1);
            fetch('@Url.Action("AddToCart","Client")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: form.toString()
            }).then(function (r) { return r.json(); }).then(function (data) {
                if (!data.ok) { return; }
                loadCartCount();
                if (goCart) { window.location.href = '@Url.Action("Cart","Client")'; }
            });
        }

        function loadCartCount() {
            fetch('@Url.Action("CartCount","Client")')
                .then(r => r.json())
                .then(data => {
                    document.getElementById('cartBadge').textContent = data.count || 0;
                });
        }

        function bindCard(card) {
            const productId = parseInt(card.getAttribute('data-product-id') || '0', 10);
            const isOutOfStock = card.getAttribute('data-out-of-stock') === '1';
            const cartBtn = card.querySelector('.cart-btn');
            const buyBtn = card.querySelector('.buy-btn');
            if (isOutOfStock) {
                if (cartBtn) cartBtn.disabled = true;
                if (buyBtn) buyBtn.disabled = true;
            }
            if (cartBtn) {
                cartBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (isOutOfStock) return;
                    addToCart(productId, false);
                });
            }
            if (buyBtn) {
                buyBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    if (isOutOfStock) return;
                    addToCart(productId, true);
                });
            }
            card.addEventListener('click', function (e) {
                if (e.target.tagName.toLowerCase() === 'button') return;
                if (isOutOfStock) return;
                const url = card.getAttribute('data-url');
                if (url) window.location.href = url;
            });
        }

        function renderCatalog(list, host, isFlash) {
            host.innerHTML = '';
            list.forEach(p => {
                const card = document.createElement('div');
                const isOutOfStock = Number(p.stock || 0) <= 0 || p.isAvailable === false;
                card.className = 'card clickable-card' + (isOutOfStock ? ' out-of-stock' : '');
                if (!isOutOfStock) {
                    card.setAttribute('data-url', '@Url.Action("Product", "Client")' + '/' + p.id);
                }
                card.setAttribute('data-product-id', p.id);
                card.setAttribute('data-out-of-stock', isOutOfStock ? '1' : '0');
                const priceHtml = isFlash
                    ? ('<span class="price"><s>₱' + Number(p.price).toFixed(2) + '</s> ₱' + Number(p.salePrice).toFixed(2) + '</span>')
                    : ('<span class="price">₱' + Number(p.price).toFixed(2) + '</span>');
                const stockHtml = isOutOfStock
                    ? '<span class="stock-badge out">Out of Stock</span>'
                    : '<span class="stock-badge in">In Stock</span>';

                card.innerHTML =
                    '<img src=\"' + p.image + '\" />' +
                    '<h2 class=\"product-name\">' + p.name + '</h2>' +
                    '<p>' + p.medium + '</p>' +
                    priceHtml +
                    stockHtml +
                    '<div class=\"buttons\"><button class=\"cart-btn\" type=\"button\">Add to cart</button><button class=\"buy-btn\" type=\"button\">Buy now</button></div>';
                host.appendChild(card);
                bindCard(card);
            });
        }

        function loadCatalog() {
            fetch('@Url.Action("Catalog","Client")')
                .then(r => r.json())
                .then(data => {
                    renderCatalog(data.hotSales || [], hotSalesGrid, false);
                    renderCatalog(data.flashSales || [], flashSalesGrid, true);
                });
        }

        loadCartCount();
        loadCatalog();

        // Filter button functionality
        const filterBtn = document.querySelector('.dropdown-header');
        const dropdownOverlay = document.querySelector('.dropdown-overlay');
        const closeBtn = document.querySelector('.close-btn');

        filterBtn.addEventListener('click', () => {
            dropdownOverlay.classList.toggle('active');
        });

        closeBtn.addEventListener('click', () => {
            dropdownOverlay.classList.remove('active');
        });

        dropdownOverlay.addEventListener('click', (e) => {
            if (e.target === dropdownOverlay) {
                dropdownOverlay.classList.remove('active');
            }
        });
    </script>
</body>
</html>
