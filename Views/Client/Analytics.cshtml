@{
    ViewBag.Title = "Analytics";
    ViewBag.Page = "analytics";
    ViewBag.PageLabel = "Analytics";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/CSS/Analytics.css")" rel="stylesheet" />
}

<div class="analytics-layout">

    <!-- MONTH NAVIGATOR -->
    <div class="analytics-month-nav">
        <button class="month-arrow" id="prevMonth">&#9664;</button>
        <span class="month-label-text" id="monthLabel">JANUARY</span>
        <button class="month-arrow" id="nextMonth">&#9654;</button>
    </div>

    <!-- 3-COLUMN GRID -->
    <div class="analytics-grid">

        <!-- LEFT: Spending + Delivery -->
        <div class="analytics-left">

            <div class="revenue-box">
                <div class="revenue-label">TOTAL SPENDING</div>
                <div class="revenue-amount">&#8369;@(ViewBag.TotalSpent ?? "0.00")</div>
            </div>

            <div class="duedates-box">
                <div class="duedates-label">UPCOMING DELIVERY</div>
                <div class="duedate-row">
                    <span>Order #A102</span>
                    <span>January 13</span>
                </div>
                <div class="duedate-row">
                    <span>Order #A118</span>
                    <span>January 22</span>
                </div>
                <div class="duedate-empty"></div>
            </div>

        </div>

        <!-- CENTER: Chart -->
        <div class="chart-box">
            <canvas id="revenueChart"></canvas>
        </div>

        <!-- RIGHT: Buyer order status -->
        <div class="stocks-box">
            <div class="stocks-label">ORDER STATUS</div>
            <div class="stock-row red">   <span>To Pay</span>      <span>x1</span> </div>
            <div class="stock-row green"> <span>To Ship</span>     <span>x2</span> </div>
            <div class="stock-row lime">  <span>To Receive</span>  <span>x3</span> </div>
            <div class="stock-row empty"></div>
            <div class="stock-row empty"></div>
            <div class="stock-row empty"></div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script type="text/javascript">

        // ── Month navigation data ──
        var months = [
            'JANUARY', 'FEBRUARY', 'MARCH', 'APRIL', 'MAY', 'JUNE',
            'JULY', 'AUGUST', 'SEPTEMBER', 'OCTOBER', 'NOVEMBER', 'DECEMBER'
        ];
        var currentMonth = 0;

        // Sample weekly spending data per month
        var weekData = [
            [600, 420, 780, 650], // January
            [520, 310, 640, 590], // February
            [390, 700, 510, 820], // March
            [460, 480, 530, 600], // April
            [780, 650, 710, 690], // May
            [550, 470, 620, 660], // June
            [430, 500, 580, 610], // July
            [620, 690, 540, 700], // August
            [740, 710, 680, 760], // September
            [520, 560, 610, 640], // October
            [680, 730, 690, 820], // November
            [820, 910, 870, 980]  // December
        ];

        document.getElementById('prevMonth').addEventListener('click', function () {
            currentMonth = (currentMonth - 1 + 12) % 12;
            document.getElementById('monthLabel').textContent = months[currentMonth];
            chart.data.datasets[0].data = weekData[currentMonth];
            chart.update('active');
        });

        document.getElementById('nextMonth').addEventListener('click', function () {
            currentMonth = (currentMonth + 1) % 12;
            document.getElementById('monthLabel').textContent = months[currentMonth];
            chart.data.datasets[0].data = weekData[currentMonth];
            chart.update('active');
        });

        function getChartSizing() {
            var ref = Math.min(window.innerWidth, window.innerHeight * 1.8);
            var legendSize = Math.max(12, Math.min(26, Math.round(ref * 0.018)));
            var tickSize = Math.max(11, Math.min(22, Math.round(ref * 0.016)));
            var titleSize = Math.max(13, Math.min(26, Math.round(ref * 0.02)));

            return {
                legendSize: legendSize,
                tickSize: tickSize,
                titleSize: titleSize
            };
        }

        // ── Chart.js line chart ──
        var chartSizing = getChartSizing();
        var ctx = document.getElementById('revenueChart').getContext('2d');
        var chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4'],
                datasets: [{
                    label: 'Spending',
                    data: weekData[0],
                    borderColor: '#BF4646',
                    backgroundColor: 'rgba(191,70,70,0.08)',
                    pointBackgroundColor: '#BF4646',
                    pointBorderColor: '#BF4646',
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    borderWidth: 2.5,
                    tension: 0.15,
                    fill: false
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        labels: {
                            font: { family: 'Poppins', weight: 'bold', size: chartSizing.legendSize },
                            color: '#1a1a1a',
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    }
                },
                scales: {
                    x: {
                        title: {
                            display: true,
                            text: 'Weeks',
                            font: { family: 'Poppins', weight: 'bold', size: chartSizing.titleSize },
                            color: '#1a1a1a'
                        },
                        ticks: { font: { family: 'Poppins', weight: '700', size: chartSizing.tickSize }, color: '#1a1a1a' },
                        grid: { color: 'rgba(0,0,0,0.08)' }
                    },
                    y: {
                        title: {
                            display: true,
                            text: 'Amount (PHP)',
                            font: { family: 'Poppins', weight: 'bold', size: chartSizing.titleSize },
                            color: '#1a1a1a'
                        },
                        ticks: { font: { family: 'Poppins', weight: '700', size: chartSizing.tickSize }, color: '#1a1a1a' },
                        grid: { color: 'rgba(0,0,0,0.08)' },
                        min: 0
                    }
                }
            }
        });

        window.addEventListener('resize', function () {
            var resized = getChartSizing();
            chart.options.plugins.legend.labels.font.size = resized.legendSize;
            chart.options.scales.x.title.font.size = resized.titleSize;
            chart.options.scales.y.title.font.size = resized.titleSize;
            chart.options.scales.x.ticks.font.size = resized.tickSize;
            chart.options.scales.y.ticks.font.size = resized.tickSize;
            chart.update('none');
        });
    </script>
}
