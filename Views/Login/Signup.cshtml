@model ArtZada.Controllers.SignupViewModel
@{
    ViewBag.Title = "Signup";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.PageClass = "signup-page";
}

<div class="auth-card">
    <div class="auth-title">Sign-up</div>

    @using (Html.BeginForm("Signup", "Login", FormMethod.Post, new { autocomplete = "off" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger auth-validation" })

        <div class="auth-form-group">
            @Html.LabelFor(m => m.LastName, new { @class = "auth-label" })
            @Html.TextBoxFor(m => m.LastName, new { @class = "auth-input" })
            @Html.ValidationMessageFor(m => m.LastName, "", new { @class = "text-danger" })
        </div>

        <div class="auth-form-group">
            @Html.LabelFor(m => m.FirstName, new { @class = "auth-label" })
            @Html.TextBoxFor(m => m.FirstName, new { @class = "auth-input" })
            @Html.ValidationMessageFor(m => m.FirstName, "", new { @class = "text-danger" })
        </div>

        <div class="auth-form-group">
            @Html.LabelFor(m => m.Username, new { @class = "auth-label" })
            @Html.TextBoxFor(m => m.Username, new { @class = "auth-input" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>

        <div class="auth-form-group">
            @Html.LabelFor(m => m.Password, new { @class = "auth-label" })
            <div class="auth-password-wrap">
                @Html.PasswordFor(m => m.Password, new { @class = "auth-input", id = "signupPassword" })
                <button type="button" class="auth-toggle-password" aria-label="Toggle password visibility" onclick="togglePassword('signupPassword', this)">&#128065;</button>
            </div>
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>

        <div class="auth-form-group">
            @Html.LabelFor(m => m.ConfirmPassword, new { @class = "auth-label" })
            <div class="auth-password-wrap">
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "auth-input", id = "signupConfirmPassword" })
                <button type="button" class="auth-toggle-password" aria-label="Toggle password visibility" onclick="togglePassword('signupConfirmPassword', this)">&#128065;</button>
            </div>
            @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
        </div>

        <div class="auth-actions">
            <button type="submit" class="auth-btn auth-btn-primary">Confirm!</button>
            <a class="auth-btn auth-btn-secondary"
               href="@Url.Action("Login", "Login")"
               style="display:inline-flex; justify-content:center; align-items:center;">
                Cancel
            </a>
        </div>
    }
</div>

@section scripts {
    <script>
        function togglePassword(inputId, button) {
            var input = document.getElementById(inputId);
            if (!input) {
                return;
            }

            var visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            button.classList.toggle('is-visible', !visible);
        }
    </script>
}
