@{
    ViewBag.Title = "AddItem";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Add Item - Seller</title>
    <style>
        @@font-face {
            font-family: 'RushonGround';
            src: url('/Content/Font/Rushon Ground.ttf') format('truetype');
            font-weight: normal;
            font-style: normal;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #EDDCC6;
            background-image: url('/Content/images/paperbg.png');
            background-repeat: no-repeat;
            background-position: center center;
            background-attachment: fixed;
            background-size: cover;
            color: #333;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar-container {
            background: #BF4646;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 50px;
            position: relative;
            z-index: 10;
        }

        .nav-logo {
            position: absolute;
            left: 20px;
            display: flex;
            align-items: center;
        }

            .nav-logo svg {
                width: 44px;
                height: 28px;
            }

        .navbar {
            display: flex;
            gap: 60px;
        }

            .navbar a {
                color: rgba(0,0,0,0.75);
                font-family: 'Poppins', sans-serif;
                font-weight: 700;
                text-decoration: none;
                font-size: 14px;
                letter-spacing: 0.5px;
                transition: color 0.2s;
            }

                .navbar a:hover {
                    color: rgba(0,0,0,0.95);
                }

                .navbar a.active {
                    color: #fff;
                }

        .nav-bell {
            position: absolute;
            right: 0;
            top: 0;
            width: 80px;
            height: 78px;
            background: #BF4646;
            border-bottom-left-radius: 18px;
            border-bottom-right-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: filter 0.15s;
            z-index: 20;
        }

            .nav-bell:hover {
                filter: brightness(1.15);
            }

            .nav-bell img {
                width: 46px;
                height: 46px;
                object-fit: contain;
                margin-top: 20px;
            }

        .page-content {
            flex: 1;
            padding: 24px 36px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
        }

        .title-wrap {
            width: 88%;
        }

        .page-title {
            font-family: 'RushonGround', cursive;
            font-size: 4rem;
            color: #1a1a1a;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            -webkit-text-stroke: 2px #1a1a1a;
            line-height: 1;
        }

        .form-panel {
            background: #7EACB5;
            border-radius: 18px;
            padding: 22px 26px;
            display: flex;
            gap: 24px;
            align-items: stretch;
            width: 88%;
            min-height: 420px;
        }

        .photo-col {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
        }

        .photo-box {
            width: 220px;
            height: 220px;
            border: 5px solid #1a1a1a;
            border-radius: 10px;
            overflow: hidden;
            background: #276470;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .photo-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

        .btn-add-photo {
            width: 220px;
            background: #276470;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.2rem;
            padding: 10px 0;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            text-align: center;
        }

            .btn-add-photo:hover {
                filter: brightness(1.15);
                transform: translateY(-2px);
            }

            .btn-add-photo:active {
                transform: translateY(0);
                filter: brightness(0.88);
            }

        .btn-cancel-left {
            width: 120px;
            background: #BF4646;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.78rem;
            padding: 6px 0;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            text-align: center;
        }

            .btn-cancel-left:hover {
                filter: brightness(1.15);
                transform: translateY(-2px);
            }

            .btn-cancel-left:active {
                transform: translateY(0);
                filter: brightness(0.88);
            }

        .fields-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        .fields-row {
            display: flex;
            gap: 12px;
            align-items: stretch;
            flex: 1;
        }

        .field-label {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.9rem;
            color: rgba(0,0,0,0.5);
            margin-bottom: 2px;
            display: block;
        }

        .field-input {
            width: 100%;
            background: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 9px 12px;
            font-family: 'RushonGround', cursive;
            font-weight: 600;
            font-size: 1.4rem;
            color: #1a1a1a;
            outline: none;
        }

        #itemName {
            font-size: 1.6rem;
            padding: 12px 12px;
        }

        .field-input:focus {
            box-shadow: 0 0 0 3px rgba(39,100,112,0.35);
        }

        .field-input.regular-font {
            font-family: 'Poppins', sans-serif;
            font-size: 0.88rem;
        }

        .type-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .type-row .field-label {
                margin-bottom: 0;
                white-space: nowrap;
            }

        .type-select-wrap {
            flex: 1;
            position: relative;
        }

            .type-select-wrap select {
                width: 100%;
                appearance: none;
                -webkit-appearance: none;
                background: #ffffff;
                border: none;
                border-radius: 6px;
                padding: 9px 44px 9px 12px;
                font-family: 'Poppins', sans-serif;
                font-weight: 600;
                font-size: 0.88rem;
                color: #1a1a1a;
                outline: none;
                cursor: pointer;
            }

        .dropdown-arrow {
            position: absolute;
            right: 0;
            top: 0;
            height: 100%;
            width: 40px;
            background: #D88628;
            border-radius: 0 6px 6px 0;
            border: 2px solid #1a1a1a;
            display: flex;
            align-items: center;
            justify-content: center;
            pointer-events: none;
        }

            .dropdown-arrow svg {
                width: 20px;
                height: 20px;
                fill: #fff;
            }

        .price-stock-row {
            display: flex;
            gap: 14px;
        }

            .price-stock-row .field-group {
                flex: 1;
            }

        .field-textarea {
            width: 100%;
            background: #ffffff;
            border: none;
            border-radius: 6px;
            padding: 9px 12px;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 0.88rem;
            color: #1a1a1a;
            outline: none;
            resize: none;
            height: 90px;
        }

            .field-textarea:focus {
                box-shadow: 0 0 0 3px rgba(39,100,112,0.35);
            }

        .fields-inner {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .right-actions {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            gap: 6px;
            flex-shrink: 0;
            align-self: stretch;
        }

        .btn-submit {
            background: #5DDB44;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            padding: 10px 22px;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            white-space: nowrap;
            text-align: center;
            min-width: 120px;
        }

            .btn-submit:hover {
                filter: brightness(1.1);
                transform: translateY(-2px);
            }

            .btn-submit:active {
                transform: translateY(0);
                filter: brightness(0.9);
            }

        .btn-cancel-right {
            background: #BF4646;
            border: 4px solid #1a1a1a;
            border-radius: 10px;
            color: #ffffff;
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 0.78rem;
            padding: 6px 16px;
            cursor: pointer;
            transition: filter 0.15s, transform 0.1s;
            white-space: nowrap;
            text-align: center;
            min-width: 90px;
        }

            .btn-cancel-right:hover {
                filter: brightness(1.1);
                transform: translateY(-2px);
            }

            .btn-cancel-right:active {
                transform: translateY(0);
                filter: brightness(0.9);
            }

        @@media (max-width: 900px) {
            .form-panel, .title-wrap {
                width: 100%;
            }

            .form-panel {
                flex-direction: column;
                align-items: center;
            }

            .navbar {
                gap: 20px;
            }
        }
    </style>
</head>
<body>
    <div class="navbar-container">
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white"></polygon>
                <polygon points="26,4  42,14  26,24" fill="white"></polygon>
            </svg>
        </div>
        <nav class="navbar">
            <a href="@Url.Action("SellerSideStore","Home")" class="active">Store</a>
            <a href="@Url.Action("SellerSideMessage","Home")">Message</a>
            <a href="@Url.Action("SellerSideAnalytics","Home")">Analytics</a>
            <a href="@Url.Action("SellerSideAccount","Home")">Account</a>
        </nav>
        <div class="nav-bell" onclick="window.location.href='@Url.Action("Notifications","Home")'">
            <img src="@Url.Content("~/Content/images/notification.png")" alt="Notifications" />
        </div>
    </div>

    <div class="page-content">
        <div class="title-wrap">
            <div class="page-title">Add Item</div>
        </div>
        <div class="form-panel">
            <div class="photo-col">
                <div class="photo-box">
                    <img id="photoPreview" src="@Url.Content("~/Content/images/artzada_logo.png")" alt="Item Photo" />
                </div>
                <button class="btn-add-photo" type="button" onclick="document.getElementById('photoInput').click()">
                    Add Photo
                </button>
                <button class="btn-cancel-left" type="button" onclick="window.location.href='@Url.Action("SellerSideStore","Home")'">
                    Cancel
                </button>
                <input type="file" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(event)" />
            </div>
            <div class="fields-col">
                <div class="fields-row">
                    <div class="fields-inner">
                        <div class="field-group">
                            <label class="field-label">Name</label>
                            <input type="text" class="field-input" id="itemName" />
                        </div>
                        <div class="type-row">
                            <label class="field-label">Type</label>
                            <div class="type-select-wrap">
                                <select id="itemType">
                                    <option value=""></option>
                                    <option value="Digital Print">Digital Print</option>
                                    <option value="Sticker">Sticker</option>
                                    <option value="Poster">Poster</option>
                                    <option value="Canvas">Canvas</option>
                                    <option value="Commission">Commission</option>
                                </select>
                                <div class="dropdown-arrow">
                                    <svg viewBox="0 0 24 24"><path d="M7 10l5 5 5-5z"></path></svg>
                                </div>
                            </div>
                        </div>
                        <div class="price-stock-row">
                            <div class="field-group">
                                <label class="field-label">Price</label>
                                <input type="number" class="field-input regular-font" id="itemPrice" placeholder="0.00" min="0" step="0.01" />
                            </div>
                            <div class="field-group">
                                <label class="field-label">Stocks</label>
                                <input type="number" class="field-input regular-font" id="itemStocks" placeholder="0" min="0" />
                            </div>
                        </div>
                        <div class="field-group">
                            <label class="field-label">Description</label>
                            <textarea class="field-textarea" id="itemDescription"></textarea>
                        </div>
                    </div>
                    <div class="right-actions">
                        <button class="btn-submit" type="button" onclick="submitItem()">Add Item</button>
                        <button class="btn-cancel-right" type="button" onclick="window.location.href='@Url.Action("SellerSideStore","Home")'">
                            Cancel
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        var currentPhotoData = '/Content/images/artzada_logo.png';

        function previewPhoto(event) {
            var file = event.target.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function (e) {
                currentPhotoData = e.target.result;
                document.getElementById('photoPreview').src = currentPhotoData;
            };
            reader.readAsDataURL(file);
        }

        function submitItem() {
            var name  = document.getElementById('itemName').value.trim();
            var type  = document.getElementById('itemType').value;
            var price = document.getElementById('itemPrice').value;
            var stocks = document.getElementById('itemStocks').value;
            var desc  = document.getElementById('itemDescription').value.trim();

            if (!name)   { alert('Please enter a name.');         return; }
            if (!type)   { alert('Please select a type.');        return; }
            if (!price)  { alert('Please enter a price.');        return; }
            if (!stocks) { alert('Please enter a stock amount.'); return; }

            var items = JSON.parse(localStorage.getItem('sellerItems') || '[]');
            var newItem = {
                id: Date.now().toString(),
                name: name,
                type: type,
                price: price,
                stocks: stocks,
                description: desc,
                photo: currentPhotoData
            };
            items.push(newItem);
            localStorage.setItem('sellerItems', JSON.stringify(items));

            window.location.href = '@Url.Action("SellerSideStore","Home")';
        }
    </script>
</body>
</html>