@{
    ViewBag.Title = "Messaging";
    ViewBag.Page = "message";
    ViewBag.PageLabel = "Messaging";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Messages</title>
    <link rel="stylesheet" href="~/Content/site.css" />
</head>

<body>

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="nav-arrows">
            <button class="nav-btn">&#9664;</button>
            <button class="nav-btn">&#9654;</button>
        </div>

    </div>

    <div class="message-layout">

        <!-- LEFT PANEL -->
        <div class="message-sidebar">

            <div class="sidebar-header">
                <div class="profile">
                    <div class="profile-pic"></div>
                    <strong>Chats</strong>
                </div>
            </div>

            <!-- USERS -->
            <div class="sidebar-user" onclick="loadChat('User 1')">
                <div class="profile-pic small"></div>
                <span>User 1</span>
            </div>

            <div class="sidebar-user" onclick="loadChat('User 2')">
                <div class="profile-pic small"></div>
                <span>User 2</span>
            </div>

        </div>

        <!-- CHAT PANEL -->
        <div class="chat-panel">

            <!-- HEADER -->
            <div class="chat-header">
                <div class="profile">
                    <div class="profile-pic"></div>
                    <strong id="chatName">KWEKKWEKSASTIX</strong>
                </div>
            </div>

            <!-- CHAT -->
            <div class="chat-body" id="chatBody">
                <!-- Messages will load here -->
            </div>

            <!-- INPUT -->
            <div class="chat-input">

                <label class="attach-btn">
                    📎
                    <input type="file" accept="image/png" hidden />
                </label>

                <input type="text" id="messageInput" placeholder="Ayos" />
                <button onclick="sendMessage()">Send</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        function sendMessage() {
            var input = document.getElementById('msgInput');
            var text = input.value.trim();
            if (!text) return;
            var body = document.getElementById('chatBody');
            var row = document.createElement('div');
            row.className = 'chat-row sent';
            row.innerHTML = '<div class="bubble sent">' + escHtml(text) + '</div>';
            body.appendChild(row);
            body.scrollTop = body.scrollHeight;
            input.value = '';
        }

        function handleKey(e) { if (e.key === 'Enter') sendMessage(); }

        function escHtml(t) {
            return t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        }

        function selectContact(el, name) {
            document.querySelectorAll('.chat-contact').forEach(function (c) { c.classList.remove('selected'); });
            el.classList.add('selected');
            document.getElementById('chatHeaderName').textContent = name;
            document.getElementById('chatBody').innerHTML = '<div class="chat-date">Today</div>';
        }

        /* ── ATTACH FILE HANDLER ──
           Images show as preview bubble
           Other files show as filename bubble */
        function handleAttach(input) {
            var file = input.files[0];
            if (!file) return;
            var body = document.getElementById('chatBody');
            var row = document.createElement('div');
            row.className = 'chat-row sent';

            if (file.type.startsWith('image/')) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    row.innerHTML = '<div class="bubble sent" style="padding:6px;">' +
                        '<img src="' + e.target.result + '" style="max-width:200px;max-height:150px;border-radius:10px;display:block;" />' +
                        '</div>';
                    body.appendChild(row);
                    body.scrollTop = body.scrollHeight;
                };
                reader.readAsDataURL(file);
            } else {
                row.innerHTML = '<div class="bubble sent">📎 ' + escHtml(file.name) + '</div>';
                body.appendChild(row);
                body.scrollTop = body.scrollHeight;
            }
            input.value = '';
        }
    </script>
}