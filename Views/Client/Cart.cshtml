@{
    ViewBag.Title = "Cart";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cart</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;700&display=swap" rel="stylesheet" />
    <link href="@Url.Content("~/Content/CSS/Cart.css")" rel="stylesheet" />
</head>

<body>
    @Html.AntiForgeryToken()

    @{
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    }

    <!-- NAVBAR -->
    <div class="navbar-container">
        <div class="navbar">
            <a href="/Client/Index" class="@(currentAction == "Index" ? "active" : "")">Home</a>
            <a href="#">Shop</a>
            <a href="/Client/Message" class="@(currentAction == "Message" ? "active" : "")">Message</a>
            <a href="/Client/Cart" class="@(currentAction == "Cart" ? "active" : "")">Cart</a>
            <a href="/Client/Account" class="@(currentAction == "Account" ? "active" : "")">Account</a>
        </div>
    </div>

    <!-- CART -->
    <div class="cart-wrapper" id="cartWrapper">
        <h1 class="cart-title" id="cartArtistTitle" style="display:none;"></h1>
    </div>

    <!-- OVERLAY -->
    <div id="overlay" class="overlay"></div>

    <!-- CHECKOUT BAR -->
    <div class="checkout-bar" id="checkoutBar">

        <!-- COLLAPSED -->
        <div class="checkout-inner">
            <h2>Total <span id="totalTop">₱0.00</span></h2>
            <button class="checkout-btn" onclick="openCheckout()">Check out</button>
        </div>

        <!-- EXPANDED -->
        <div class="checkout-expanded">

            <div class="form-row">
                <label>Full Name:</label>
                <input type="text" id="fullNameInput">
            </div>

            <div class="form-row">
                <label>Address:</label>
                <input type="text" id="addressInput">
            </div>

            <div class="form-row">
                <label>Payment:</label>
                <select id="paymentInput">
                    <option>COD</option>
                    <option>GCash</option>
                </select>
            </div>

            <div class="checkout-bottom">
                <h3>Total: <span id="totalBottom">₱0.00</span></h3>
                <button class="place-order-btn" id="placeOrderBtn">Place Order</button>
            </div>

        </div>
    </div>

    <!-- SCRIPT -->
    <script>
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;

        function money(v) { return '₱' + Number(v || 0).toFixed(2); }

        function renderCart(items, total) {
            var wrapper = document.getElementById('cartWrapper');
            var title = document.getElementById('cartArtistTitle');
            wrapper.querySelectorAll('.cart-item').forEach(function (n) { n.remove(); });
            title.style.display = 'none';
            title.textContent = '';

            var artists = [];

            items.forEach(function (item) {
                if (item.artistName && artists.indexOf(item.artistName) === -1) {
                    artists.push(item.artistName);
                }
                var row = document.createElement('div');
                row.className = 'cart-item';
                var imageSrc = item.image ? item.image : '/Content/images/artzada_logo.png';
                row.innerHTML =
                    '<input type=\"checkbox\" class=\"cart-checkbox\" checked />' +
                    '<img src=\"' + imageSrc + '\" class=\"cart-img\" />' +
                    '<div class=\"cart-info\"><div class=\"cart-name\">' + item.name + '</div><div class=\"cart-type\">Qty: ' + item.quantity + '</div></div>' +
                    '<div class=\"cart-price\">' + money(item.lineTotal) + '</div>' +
                    '<button type=\"button\" class=\"checkout-btn\" style=\"margin-left:8px\" data-remove-id=\"' + item.productId + '\">Remove</button>';
                wrapper.appendChild(row);
            });

            if (artists.length > 0) {
                title.textContent = 'ART BY ' + artists.join(', ').toUpperCase();
                title.style.display = '';
            }

            wrapper.querySelectorAll('[data-remove-id]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var form = new URLSearchParams();
                    form.append('__RequestVerificationToken', token);
                    form.append('productId', btn.getAttribute('data-remove-id'));
                    fetch('@Url.Action("RemoveCartItem","Client")', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                        body: form.toString()
                    }).then(function () { loadCart(); });
                });
            });

            document.getElementById('totalTop').textContent = money(total);
            document.getElementById('totalBottom').textContent = money(total);
        }

        function loadCart() {
            fetch('@Url.Action("GetCart","Client")')
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.ok) { return; }
                    renderCart(data.items || [], data.total || 0);
                });
        }

        function openCheckout() {
            document.getElementById("checkoutBar").classList.add("expanded");
            document.getElementById("overlay").classList.add("active");
        }

        function closeCheckout() {
            document.getElementById("checkoutBar").classList.remove("expanded");
            document.getElementById("overlay").classList.remove("active");
        }

        document.addEventListener("click", function (e) {
            var checkout = document.getElementById("checkoutBar");

            if (checkout.classList.contains("expanded")) {
                if (!checkout.contains(e.target)) {
                    closeCheckout();
                }
            }
        });

        document.getElementById("checkoutBar").addEventListener("click", function (e) {
            e.stopPropagation();
        });

        document.getElementById("overlay").addEventListener("click", closeCheckout);

        document.getElementById('placeOrderBtn').addEventListener('click', function () {
            var fullName = document.getElementById('fullNameInput').value.trim();
            var address = document.getElementById('addressInput').value.trim();
            var payment = document.getElementById('paymentInput').value;

            var form = new URLSearchParams();
            form.append('__RequestVerificationToken', token);
            form.append('fullName', fullName);
            form.append('address', address);
            form.append('paymentMethod', payment);

            fetch('@Url.Action("PlaceOrder","Client")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                body: form.toString()
            }).then(function (r) { return r.json(); })
            .then(function (data) {
                if (!data.ok) {
                    if (window.themeToast) window.themeToast(data.message || 'Failed to place order.', 'warn');
                    return;
                }
                if (window.themeToast) window.themeToast('Order placed successfully.', 'success');
                closeCheckout();
                loadCart();
            });
        });

        loadCart();
    </script>

</body>
</html>
