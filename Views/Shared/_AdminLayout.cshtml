@{
    var adminUser = (Session["AdminUserName"] as string) ?? "admin";
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ArtZada Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body class="admin-shell">

    <div class="top-bar">
        <div class="header">
            <div class="logo">
                <a href="@Url.Action("UserOverview", "Admin")"><img src="~/Content/images/artzada_logo.png" alt="Artzada Logo" /></a>
            </div>

            <div class="search-panel">
                <div class="search-container">
                    <button class="search-btn" type="button">
                        <img src="~/Content/images/search.png" alt="Search" />
                    </button>
                    <input type="text" placeholder="Search Users" />
                </div>
            </div>
        </div>

        <div class="navbar-container">
            <div class="nav-arrows">
                <button class="nav-btn" type="button">&#9664;</button>
                <button class="nav-btn" type="button">&#9654;</button>
            </div>

            <div class="navbar">
                <a href="@Url.Action("UserOverview", "Admin")" class="@(string.Equals(currentAction, "UserOverview") ? "active" : "")">User Management</a>
                <a href="@Url.Action("Pending", "Admin")" class="@(string.Equals(currentAction, "Pending") ? "active" : "")">Pending</a>
                <a href="@Url.Action("BannedListed", "Admin")" class="@(string.Equals(currentAction, "BannedListed") ? "active" : "")">Banned Listed</a>
                <a href="@Url.Action("Account", "Admin")" class="@(string.Equals(currentAction, "Account") ? "active" : "")">Account</a>
            </div>
        </div>
    </div>

    <div class="admin-shell-spacer"></div>

    @RenderBody()

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
