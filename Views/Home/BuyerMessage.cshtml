@{
    ViewBag.Title = "BuyerMessage";
    ViewBag.Page = "message";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/Content/CSS/BuyerMessage.css")" />
}

<div class="buyer-message-layout">
    <div class="buyer-left-panel">
        <div class="buyer-contact-header"><strong>KWEKKWEKSASTIX</strong></div>
        <div class="buyer-contact-card"></div>
        <div class="buyer-contact-card"></div>
    </div>

    <div class="buyer-chat-panel">
        <div class="buyer-chat-header"><strong>KWEKKWEKSASTIX</strong></div>

        <div class="buyer-chat-body">
            <p><strong>April 9</strong></p>

            <div class="buyer-bubble buyer-bubble-left">Kwekkwek ka ba?</div>
            <div class="buyer-bubble buyer-bubble-right">Bakit?</div>
            <div class="buyer-bubble buyer-bubble-left">Sarap mo kasi tusukin</div>
            <div class="buyer-bubble buyer-bubble-right">haha</div>
        </div>

        <div class="buyer-input-row">
            <input type="text" placeholder="Ayos" class="buyer-input" />
            <button type="button" class="buyer-send-btn">Send</button>
        </div>
    </div>
</div>
