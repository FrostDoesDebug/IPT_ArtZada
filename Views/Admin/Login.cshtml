
@model ArtZada.Controllers.LoginViewModel

@{
    ViewBag.Title = "Admin Login";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewBag.PageClass = "admin-login-page";
}


<div class="admin-login-bg-layer" aria-hidden="true">
    <img class="admin-login-bg admin-login-bg-admin" src="@Url.Content("~/Content/images/ADMIN.png")" alt="" />
    <img class="admin-login-bg admin-login-bg-access" src="@Url.Content("~/Content/images/ACCESS.png")" alt="" />
</div>

<div class="admin-login-content">
    <div class="auth-card">
        <div class="auth-title">Login</div>

        @using (Html.BeginForm("Login", "Admin", FormMethod.Post, new { autocomplete = "off" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger auth-validation" })

            <div class="auth-form-group">
                @Html.LabelFor(m => m.Username, new { @class = "auth-label" })
                @Html.TextBoxFor(m => m.Username, new { @class = "auth-input" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <div class="auth-form-group">
                @Html.LabelFor(m => m.Password, new { @class = "auth-label" })
                <div class="auth-password-wrap">
                    @Html.PasswordFor(m => m.Password, new { @class = "auth-input", id = "adminPassword" })
                    <button type="button" class="auth-toggle-password" aria-label="Toggle password visibility" onclick="togglePassword('adminPassword', this)">&#128065;</button>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="auth-actions">
                <button type="submit" class="auth-btn auth-btn-primary">Continue</button>
            </div>
        }
    </div>
</div>

@section scripts {
    <script>
        function togglePassword(inputId, button) {
            var input = document.getElementById(inputId);
            if (!input) return;
            var visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            button.classList.toggle('is-visible', !visible);
        }
    </script>
}

