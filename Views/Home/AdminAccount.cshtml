@{
    ViewBag.Title = "AdminAccount";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Account – Admin Panel</title>
    <link href="@Url.Content("~/Content/CSS/AdminAccount.css")" rel="stylesheet" />
</head>
<body>

    <div class="navbar-container">
        <div class="nav-logo">
            <svg viewBox="0 0 44 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <polygon points="2,14  18,4  18,24" fill="white" />
                <polygon points="26,4  42,14  26,24" fill="white" />
            </svg>
        </div>
        <nav class="navbar">
            <a href="@Url.Action("Index","Home")" id="nav-usermgmt">User Management</a>
            <a href="@Url.Action("Index","Home")" id="nav-pending">Pending</a>
            <a href="@Url.Action("Index","Home")" id="nav-banlisted">Ban Listed</a>
            <a href="@Url.Action("AdminAccount","Home")" id="nav-account" class="active">Account</a>
        </nav>
    </div>

    <div class="page-content">
        <div class="account-card">

            <div class="card-actions" id="cardActions">
                <button class="btn-save" onclick="saveChanges()">Save Changes</button>
                <button class="btn-cancel-edit" onclick="cancelChanges()">Cancel</button>
            </div>

            <div class="account-header">
                <div class="avatar-wrapper" onclick="document.getElementById('avatarInput').click()">
                    <img class="account-avatar" id="avatarImg"
                         src="@Url.Content("~/Content/images/admin-avatar.png")"
                         alt="Admin Avatar" />
                    <div class="avatar-overlay">Change Photo</div>
                </div>
                <input type="file" id="avatarInput" accept="image/*" onchange="previewAvatar(event)" />

                <span class="account-name" id="usernameDisplay" onclick="startEditUsername()">Admin</span>
                <input class="username-input" id="usernameInput" type="text" value="Admin" maxlength="30"
                       onkeydown="if(event.key==='Enter') saveChanges(); if(event.key==='Escape') cancelChanges();" />
            </div>

            <div class="account-actions">
                <button class="btn-action" onclick="startEditUsername()">Edit Username</button>
                <button class="btn-action" onclick="document.getElementById('avatarInput').click()">Change Profile</button>
                <button class="btn-action" onclick="window.location.href='@Url.Action("AdminEditAccount","Home")'">Change Password</button>
            </div>

            <div class="account-signout">
                <button class="btn-signout" onclick="openSignOutModal()">Sign Out</button>
            </div>

        </div>
    </div>

    <div class="modal-overlay" id="signOutModal">
        <div class="modal-box">
            <div class="modal-title">Want to<br />Sign Out?</div>
            <div class="modal-buttons">
                <button class="btn-confirm" onclick="window.location.href='@Url.Action("Index","Home")'">Confirm</button>
                <button class="btn-cancel" onclick="closeSignOutModal()">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        var STORAGE_KEY_NAME = 'adminUsername';
        var STORAGE_KEY_AVATAR = 'adminAvatar';

        (function () {
            var savedName = localStorage.getItem(STORAGE_KEY_NAME);
            var savedAvatar = localStorage.getItem(STORAGE_KEY_AVATAR);
            if (savedName) {
                document.getElementById('usernameDisplay').textContent = savedName;
                document.getElementById('usernameInput').value = savedName;
            }
            if (savedAvatar) {
                document.getElementById('avatarImg').src = savedAvatar;
            }
        })();

        var originalUsername = document.getElementById('usernameDisplay').textContent;
        var originalAvatar = document.getElementById('avatarImg').src;
        var pendingAvatarFile = null;
        var editingUsername = false;
        var editingAvatar = false;

        function showCardActions() { document.getElementById('cardActions').classList.add('visible'); }
        function hideCardActions() { document.getElementById('cardActions').classList.remove('visible'); }

        function startEditUsername() {
            editingUsername = true;
            var display = document.getElementById('usernameDisplay');
            var input = document.getElementById('usernameInput');
            input.value = display.textContent;
            display.style.display = 'none';
            input.style.display = 'block';
            input.focus();
            input.select();
            showCardActions();
        }

        function previewAvatar(event) {
            var file = event.target.files[0];
            if (!file) return;
            pendingAvatarFile = file;
            editingAvatar = true;
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('avatarImg').src = e.target.result;
            };
            reader.readAsDataURL(file);
            showCardActions();
        }

        function saveChanges() {
            if (editingUsername) {
                var newName = document.getElementById('usernameInput').value.trim() || originalUsername;
                document.getElementById('usernameDisplay').textContent = newName;
                originalUsername = newName;
                localStorage.setItem(STORAGE_KEY_NAME, newName);
                document.getElementById('usernameDisplay').style.display = 'block';
                document.getElementById('usernameInput').style.display = 'none';
                editingUsername = false;
            }
            if (editingAvatar) {
                var dataUrl = document.getElementById('avatarImg').src;
                originalAvatar = dataUrl;
                localStorage.setItem(STORAGE_KEY_AVATAR, dataUrl);
                pendingAvatarFile = null;
                editingAvatar = false;
            }
            hideCardActions();
        }

        function cancelChanges() {
            if (editingUsername) {
                document.getElementById('usernameDisplay').style.display = 'block';
                document.getElementById('usernameInput').style.display = 'none';
                editingUsername = false;
            }
            if (editingAvatar) {
                document.getElementById('avatarImg').src = originalAvatar;
                document.getElementById('avatarInput').value = '';
                pendingAvatarFile = null;
                editingAvatar = false;
            }
            hideCardActions();
        }

        function openSignOutModal() { document.getElementById('signOutModal').classList.add('active'); }
        function closeSignOutModal() { document.getElementById('signOutModal').classList.remove('active'); }

        document.getElementById('signOutModal').addEventListener('click', function (e) {
            if (e.target === this) closeSignOutModal();
        });
    </script>

</body>
</html>